  "transcript": [
   {
    "start": 0.0,
    "end": 2.5,
    "text": "Naast mij staat een Porsche Panamera Sport Turismo.",
    "ko": "내 옆에는 포르쉐 파나메라 스포츠 투리스모가 있다."
   },
   {
    "start": 2.5,
    "end": 3.7,
    "text": "Hij komt uit 2018,",
    "ko": "2018년식이며,"
   },
   {
    "start": 3.7,
    "end": 5.9,
    "text": "heeft 145.000 km gelopen",
    "ko": "145,000km를 주행했고"
   },
   {
    "start": 5.9,
    "end": 8.9,
    "text": "en hij heeft 463 pk.",
    "ko": "463마력을 낸다."
   },
   {
    "start": 8.9,
    "end": 10.5,
    "text": "En de prijs vertel ik je op het eind.",
    "ko": "가격은 마지막에 알려줄게."
   },
   {
    "start": 10.5,
    "end": 14.0,
    "text": "En deze auto is niet alleen snel, maar ook luxueus.",
    "ko": "이 차는 빠를 뿐만 아니라 럭셔리하다."
   },
   {
    "start": 14.0,
    "end": 17.5,
    "text": "Zo heeft hij een elektrisch panoramadak, warmtewerend glas en zelfs knee airbags.",
    "ko": "전동 파노라마 썬루프, 열차단 유리, 무릎 에어백까지 있다."
   },
   {
    "start": 17.5,
    "end": 19.5,
    "text": "Hij heeft 21-inch velgen,",
    "ko": "21인치 휠과"
   },
   {
    "start": 19.5,
    "end": 21.0,
    "text": "dubbele sportuitlaten",
    "ko": "듀얼 스포츠 배기가 있으며"
   },
   {
    "start": 21.0,
    "end": 23.5,
    "text": "en hij kostet 51.950 euro.",
    "ko": "가격은 51,950유로이다."
   },
   {
    "start": 23.5,
    "end": 29.5,
    "text": "En je vindt hem in de showroom van Dutch Cars Exclusive en natuurlijk op AutoScout24.nl.",
    "ko": "더치 카스 익스클루시브 쇼룸과 오토스카우트24에서 만날 수 있다."
   }

  "transcript": [
   {
    "start": 0.0,
    "end": 1.5,
    "text": "Met welke auto ga jij naar het strand?",
    "ko": "어떤 차를 타고 해변에 가시나요?"
   },
   {
    "start": 1.5,
    "end": 3.0,
    "text": "Kies jij voor de Fiat Topolino?",
    "ko": "피아트 토폴리노를 선택하시겠습니까?"
   },
   {
    "start": 3.0,
    "end": 4.0,
    "text": "Hij gaat maximaal 45km/u",
    "ko": "최고속도는 시속 45km이며"
   },
   {
    "start": 4.0,
    "end": 6.0,
    "text": "en je laadt hem op binnen 4 uurtjes.",
    "ko": "4시간 이내에 충전할 수 있습니다."
   },
   {
    "start": 6.0,
    "end": 8.0,
    "text": "Hij komt uit 2025",
    "ko": "2025년식이고"
   },
   {
    "start": 8.0,
    "end": 10.0,
    "text": "en hij kost €13.900.",
    "ko": "가격은 13,900유로입니다."
   },
   {
    "start": 10.0,
    "end": 12.0,
    "text": "En heb je na een dagje strand vieze voeten?",
    "ko": "그리고 해변에서 하루 보낸 뒤 발이 더러워졌나요?"
   },
   {
    "start": 12.0,
    "end": 14.0,
    "text": "Daar heeft deze Topolino ook een oplossing voor.",
    "ko": "이 토폴리노에는 그에 대한 해결책도 있습니다."
   },
   {
    "start": 14.0,
    "end": 19.0,
    "text": "Een kleine mini douche om je voeten af te spoelen.",
    "ko": "발을 씻을 수 있는 작은 미니 샤워기죠."
   },
   {
    "start": 19.0,
    "end": 21.0,
    "text": "Of kies je toch voor de M3 touring?",
    "ko": "아니면 M3 투어링을 선택하시겠습니까?"
   },
   {
    "start": 21.0,
    "end": 22.0,
    "text": "Onder de kap ligt een 3L twin-turbo zes-in-lijn",
    "ko": "본넷 아래에는 3리터 트윈터보 직렬 6기통 엔진이 있고"
   },
   {
    "start": 22.0,
    "end": 24.0,
    "text": "met 530 pk en 650 Nm koppel.",
    "ko": "530마력과 650Nm의 토크를 냅니다."
   },
   {
    "start": 24.0,
    "end": 28.0,
    "text": "En tegelijkertijd heb je 500L aan kofferruimte",
    "ko": "동시에 500리터의 트렁크 공간과"
   },
   {
    "start": 28.0,
    "end": 31.0,
    "text": "en ruimte voor het hele gezin.",
    "ko": "온 가족을 위한 공간이 있습니다."
   },
   {
    "start": 31.0,
    "end": 33.0,
    "text": "Deze BMW M3 touring komt uit 2026,",
    "ko": "이 BMW M3 투어링은 2026년식이며"
   },
   {
    "start": 33.0,
    "end": 36.0,
    "text": "heeft 6.211 km gereden",
    "ko": "6,211km를 주행했고"
   },
   {
    "start": 36.0,
    "end": 37.0,
    "text": "en hij kost €102.900.",
    "ko": "가격은 102,900유로입니다."
   },
   {
    "start": 37.0,
    "end": 46.5,
    "text": "Je vindt ze bij Auto-Point Casier en op AutoScout24.nl",
    "ko": "오토포인트 카시에와 오토스카우트24에서 만나보실 수 있습니다."

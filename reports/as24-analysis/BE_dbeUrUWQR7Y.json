  "transcript": [
   {
    "start": 0.0,
    "end": 4.0,
    "text": "De Volkswagen ID.4 versus de Volkswagen ID.7.",
    "ko": "폭스바겐 ID.4 대 폭스바겐 ID.7"
   },
   {
    "start": 4.0,
    "end": 8.0,
    "text": "De ID.7 is sportiever en aerodynamischer in zijn design.",
    "ko": "ID.7은 더 스포티하고 공기역학적인 디자인을 가지고 있습니다."
   },
   {
    "start": 8.0,
    "end": 14.0,
    "text": "De ID.7 is uitgevoerd met een 80 kWh batterij heeft een rijbereik van 618 kilometer",
    "ko": "ID.7은 80kWh 배터리가 탑재되어 있고 주행 거리는 618km입니다."
   },
   {
    "start": 14.0,
    "end": 17.5,
    "text": "en hij heeft ook 286 pk",
    "ko": "그리고 286마력도 가지고 있습니다."
   },
   {
    "start": 17.5,
    "end": 20.0,
    "text": "en hij kost €38.990.",
    "ko": "가격은 38,990유로입니다."
   },
   {
    "start": 20.0,
    "end": 25.0,
    "text": "De ID.4 heeft een hogere instap en zit hoger hij is ook ideaal voor gezinnen.",
    "ko": "ID.4는 승하차가 더 높고 포지션이 높으며 가족에게도 이상적입니다."
   },
   {
    "start": 25.0,
    "end": 33.5,
    "text": "De ID.4 heeft een batterij van 77 kWh en een rijbereik tot 547 km en hij heeft 286 pk.",
    "ko": "ID.4는 77kWh 배터리와 최대 547km의 주행 거리를 가지며 286마력입니다."
   },
   {
    "start": 33.5,
    "end": 36.0,
    "text": "De ID.4 kost €34.900.",
    "ko": "ID.4는 34,900유로입니다."
   },
   {
    "start": 36.0,
    "end": 40.5,
    "text": "Je vindt ze beide in de showroom van Falcomotive en op AutoScout24.be.",
    "ko": "Falcomotive 전시장과 AutoScout24.be에서 둘 다 만나보실 수 있습니다."
   }

  "transcript": [
   {
    "start": 0.0,
    "end": 2.1,
    "text": "Waarom ik voor deze Audi A6 Avant zou kiezen?",
    "ko": "내가 이 아우디 A6 아반트를 선택하는 이유는?"
   },
   {
    "start": 3.0,
    "end": 7.5,
    "text": "Je hebt de ruimte van een station, maar de luxe waar de A6 om bekend staat.",
    "ko": "스테이션의 넓은 공간과 A6 특유의 럭셔리함을 모두 갖췄기 때문이죠."
   },
   {
    "start": 7.5,
    "end": 11.0,
    "text": "En die felblauwe kleur gecombineerd met zwarte accenten...",
    "ko": "그리고 이 강렬한 블루 컬러에 블랙 악센트의 조합은..."
   },
   {
    "start": 11.0,
    "end": 16.5,
    "text": "en deze 22 inch velgen afgewerkt met rode remklauwen maakt hem toch supersportief.",
    "ko": "레드 캘리퍼가 적용된 22인치 휠까지 더해져 정말 스포티해 보입니다."
   },
   {
    "start": 16.5,
    "end": 21.0,
    "text": "En het is een hybride dus je rijdt lekker zuinig, maar die motoren bij elkaar hebben 367 PK.",
    "ko": "하이브리드라 연비도 좋지만, 두 엔진이 합쳐져 367마력을 발휘해요."
   },
   {
    "start": 23.5,
    "end": 28.0,
    "text": "Ik zou het wel weten! En ik ben benieuwd: waarom zou jij voor deze Audi kiezen?",
    "ko": "전 망설이지 않겠어요! 여러분은 왜 이 아우디를 선택하시겠어요?"
   },
   {
    "start": 28.0,
    "end": 39.5,
    "text": "Als je meer informatie wil over het bouwjaar, kilometerstand en de prijs, check dan even de omschrijving!",
    "ko": "연식, 주행거리, 가격 정보가 궁금하다면 설명란을 확인해보세요!"
   }

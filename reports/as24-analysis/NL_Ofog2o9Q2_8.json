  "transcript": [
   {
    "start": 0.0,
    "end": 3.5,
    "text": "7.449 euro kost deze Volkswagen Polo.",
    "ko": "7,449유로, 이 폭스바겐 폴로의 가격입니다."
   },
   {
    "start": 3.5,
    "end": 5.6,
    "text": "Hij heeft een elektrisch panoramadak,",
    "ko": "전동 파노라마 루프가 있고,"
   },
   {
    "start": 5.6,
    "end": 7.7,
    "text": "hij heeft stoffen bekleding met stoelverwarming,",
    "ko": "열선이 포함된 직물 시트와,"
   },
   {
    "start": 7.7,
    "end": 8.7,
    "text": "zwarte velgen,",
    "ko": "블랙 휠,"
   },
   {
    "start": 8.7,
    "end": 10.7,
    "text": "getint glas en cruise control.",
    "ko": "틴팅 유리와 크루즈 컨트롤이 있습니다."
   },
   {
    "start": 10.7,
    "end": 14.5,
    "text": "En hij komt uit 2011 en heeft 184.000 km gelopen.",
    "ko": "2011년식이며 184,000km를 주행했습니다."
   },
   {
    "start": 14.5,
    "end": 17.0,
    "text": "Je vindt hem in de showroom van Euromax Auto's,",
    "ko": "유로맥스 오토스 매장에서 만나보실 수 있으며,"
   },
   {
    "start": 17.0,
    "end": 19.5,
    "text": "en natuurlijk op autoscout24.nl.",
    "ko": "당연히 autoscout24.nl에서도 확인 가능합니다."
   }
  ],

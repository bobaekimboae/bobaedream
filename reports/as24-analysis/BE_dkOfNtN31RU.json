  "transcript": [
   {
    "start": 0.0,
    "end": 3.0,
    "text": "Ga jij voor de Porsche Cayenne S E-Hybrid?",
    "ko": "포르쉐 카이엔 S E-하이브리드를 선택하시겠습니까?"
   },
   {
    "start": 3.0,
    "end": 6.0,
    "text": "Hij is uitgevoerd met de Porsche Active suspension management,",
    "ko": "포르쉐 액티브 서스펜션 마니지먼트가 장착되어 있으며,"
   },
   {
    "start": 6.0,
    "end": 7.5,
    "text": "elektrisch leren stoelen",
    "ko": "전동 가죽 시트와"
   },
   {
    "start": 7.5,
    "end": 9.0,
    "text": "met memory functie,",
    "ko": "메모리 기능이 있습니다."
   },
   {
    "start": 9.0,
    "end": 10.0,
    "text": "panoramisch dak.",
    "ko": "파노라마 루프."
   },
   {
    "start": 10.0,
    "end": 14.0,
    "text": "Hij heeft een 360 graden camera met volledige 3D functie.",
    "ko": "완전한 3D 기능이 있는 360도 카메라가 있습니다."
   },
   {
    "start": 14.0,
    "end": 17.0,
    "text": "En hij is uitgevoerd met het Bose surround soundsystem.",
    "ko": "그리고 보스 서라운드 사운드 시스템이 장착되어 있습니다."
   },
   {
    "start": 17.0,
    "end": 20.0,
    "text": "22 inch velgen in het RS Spider design.",
    "ko": "RS 스파이더 디자인의 22인치 휠."
   },
   {
    "start": 20.0,
    "end": 22.0,
    "text": "Hij komt uit 2025",
    "ko": "2025년식이며"
   },
   {
    "start": 22.0,
    "end": 26.0,
    "text": "en hij heeft 11.268 kilometer op de teller.",
    "ko": "주행 거리는 11,268 킬로미터입니다."
   },
   {
    "start": 26.0,
    "end": 29.0,
    "text": "Je vindt ze bij Garage Peeters en op AutoScout24.be",
    "ko": "가라지 피터스 및 AutoScout24.be에서 찾을 수 있습니다."
   }

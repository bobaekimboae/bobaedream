  {
   "a": 26.55,
   "b": 28.75,
   "at": 26.83,
   "text": "가격은 3,590만 원이에요"
  },
  {
   "a": 29.11,
   "b": 30.82,
   "at": 29.39,
   "text": "보배드림 앱에서 확인해 보세요"

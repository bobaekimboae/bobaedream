  "transcript": [
   {
    "start": 0.0,
    "end": 2.1,
    "text": "페라리에서 가족들 타라고 만든 차,",
    "ko": "페라리에서 가족들 타라고 만든 차,"
   },
   {
    "start": 2.1,
    "end": 3.7,
    "text": "근데 가격은 집 한 채라구요?",
    "ko": "근데 가격은 집 한 채라구요?"
   },
   {
    "start": 3.7,
    "end": 6.7,
    "text": "페라리에서 처음으로 만든 4도어, 4인승 모델 푸로산게입니다.",
    "ko": "페라리에서 처음으로 만든 4도어, 4인승 모델 푸로산게입니다."
   },
   {
    "start": 6.7,
    "end": 8.7,
    "text": "2024년 12월 FMK 정식 출고한 이 차량은",
    "ko": "2024년 12월 FMK 정식 출고한 이 차량은"
   },
   {
    "start": 8.7,
    "end": 11.0,
    "text": "옵션만 약 1억 8천만원,",
    "ko": "옵션만 약 1억 8천만원,"
   },
   {
    "start": 11.0,
    "end": 13.5,
    "text": "신차 출고까지 거의 8억! 취등록세 포함이 들었습니다.",
    "ko": "신차 출고까지 거의 8억! 취등록세 포함이 들었습니다."
   },
   {
    "start": 13.5,
    "end": 17.6,
    "text": "FUV지만 자연흡기 V12 이 엔진 하나만으로도 이미 쉬운 차는 아닙니다.",
    "ko": "FUV지만 자연흡기 V12 이 엔진 하나만으로도 이미 쉬운 차는 아닙니다."
   },
   {
    "start": 17.6,
    "end": 22.4,
    "text": "옵션이 비싼 이유는 단순합니다. 이 차량을 구성하는 대부분의 부품을 주문 제작으로 만들기 때문입니다.",
    "ko": "옵션이 비싼 이유는 단순합니다. 이 차량을 구성하는 대부분의 부품을 주문 제작으로 만들기 때문입니다."
   },
   {
    "start": 22.4,
    "end": 24.6,
    "text": "외장 컬러는 그리지오 티타니오,",
    "ko": "외장 컬러는 그리지오 티타니오,"
   },
   {
    "start": 24.6,
    "end": 27.6,
    "text": "색 하나 바꾸는 것도 공정이 달라져서 옵션값이 확 올라갑니다.",
    "ko": "색 하나 바꾸는 것도 공정이 달라져서 옵션값이 확 올라갑니다."
   },
   {
    "start": 27.6,
    "end": 31.7,
    "text": "실내는 크레마와 쿠오이오 투톤. 시트, 대시보드, 도어까지 전부 가죽이라 비쌀 수밖에 없겠네요.",
    "ko": "실내는 크레마와 쿠오이오 투톤. 시트, 대시보드, 도어까지 전부 가죽이라 비쌀 수밖에 없겠네요."
   },
   {
    "start": 31.7,
    "end": 35.7,
    "text": "FUV지만 만드는 방식은 슈퍼카 그대로입니다. 이제, 가격이 이해 가시나요?",
    "ko": "FUV지만 만드는 방식은 슈퍼카 그대로입니다. 이제, 가격이 이해 가시나요?"
   }

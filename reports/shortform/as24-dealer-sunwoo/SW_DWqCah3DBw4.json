  "transcript": [
   {
    "start": 0.0,
    "end": 2.7,
    "text": "크레용 페인트에 블루 탑 후륜구동 스포츠 머신!",
    "ko": "크레용 페인트에 블루 탑 후륜구동 스포츠 머신!"
   },
   {
    "start": 2.7,
    "end": 4.6,
    "text": "하지만 오늘의 주인공은 실내입니다.",
    "ko": "하지만 오늘의 주인공은 실내입니다."
   },
   {
    "start": 4.6,
    "end": 8.0,
    "text": "안녕하세요. 포르쉐 911 카브리올레 입고되었습니다.",
    "ko": "안녕하세요. 포르쉐 911 카브리올레 입고되었습니다."
   },
   {
    "start": 8.0,
    "end": 11.4,
    "text": "실내가 주인공인 이유, 아주 자유분방하고 독창적인 실내 컬러 덕분입니다.",
    "ko": "실내가 주인공인 이유, 아주 자유분방하고 독창적인 실내 컬러 덕분입니다."
   },
   {
    "start": 11.4,
    "end": 14.5,
    "text": "클럽 레더 아가베 그린 색상의 시트가 있고요.",
    "ko": "클럽 레더 아가베 그린 색상의 시트가 있고요."
   },
   {
    "start": 14.5,
    "end": 16.5,
    "text": "옵션 프라이스는 무려 750만 원!",
    "ko": "옵션 프라이스는 무려 750만 원!"
   },
   {
    "start": 16.5,
    "end": 18.5,
    "text": "익스테리어도 신경 많이 썼습니다.",
    "ko": "익스테리어도 신경 많이 썼습니다."
   },
   {
    "start": 18.5,
    "end": 20.6,
    "text": "20인치 RS 스파이더 휠에",
    "ko": "20인치 RS 스파이더 휠에"
   },
   {
    "start": 20.6,
    "end": 22.8,
    "text": "스포츠 디자인 사이드 스커트까지.",
    "ko": "스포츠 디자인 사이드 스커트까지."
   },
   {
    "start": 22.8,
    "end": 26.3,
    "text": "베이스 모델이지만은 스포츠 배기, 스포츠 크로노 패키지 잘 들어가 있고요.",
    "ko": "베이스 모델이지만은 스포츠 배기, 스포츠 크로노 패키지 잘 들어가 있고요."
   },
   {
    "start": 26.3,
    "end": 28.5,
    "text": "PDLS 플러스 당연히 포함되어 있습니다.",
    "ko": "PDLS 플러스 당연히 포함되어 있습니다."
   },
   {
    "start": 28.5,
    "end": 32.5,
    "text": "와우, 911 라인업 중 스펙은 가장 왜소하지만 포르쉐는 포르쉐입니다.",
    "ko": "와우, 911 라인업 중 스펙은 가장 왜소하지만 포르쉐는 포르쉐입니다."
   },
   {
    "start": 32.5,
    "end": 34.6,
    "text": "공도에서 달리는 느낌이 참 좋습니다.",
    "ko": "공도에서 달리는 느낌이 참 좋습니다."
   },
   {
    "start": 34.6,
    "end": 36.8,
    "text": "오픈이 가능한 카브리올레인 건 말할 것도 없고요.",
    "ko": "오픈이 가능한 카브리올레인 건 말할 것도 없고요."
   },
   {
    "start": 36.8,
    "end": 40.0,
    "text": "통풍 시트와 보스 오디오까지 편의 사양도 잘 들어간 이 차량.",
    "ko": "통풍 시트와 보스 오디오까지 편의 사양도 잘 들어간 이 차량."
   },
   {
    "start": 40.0,
    "end": 43.6,
    "text": "기본 가격 1억 5600만 원에 추가된 옵션은 3800만 원.",
    "ko": "기본 가격 1억 5600만 원에 추가된 옵션은 3800만 원."
   },
   {
    "start": 43.6,
    "end": 46.5,
    "text": "진짜 출고 가격은 도합 1억 9460만 원입니다.",
    "ko": "진짜 출고 가격은 도합 1억 9460만 원입니다."
   },
   {
    "start": 46.5,
    "end": 50.8,
    "text": "금융리스 승계 조건에 이 차량을 현재 위탁 판매 중입니다.",
    "ko": "금융리스 승계 조건에 이 차량을 현재 위탁 판매 중입니다."
   },
   {
    "start": 50.8,
    "end": 53.0,
    "text": "구매에 필요한 자세한 내용은 하단 본문을 참고해 주세요.",
    "ko": "구매에 필요한 자세한 내용은 하단 본문을 참고해 주세요."
   },
   {
    "start": 53.0,
    "end": 56.8,
    "text": "팔로우도 잊지 마시고요! 다양한 차량들을 소개합니다.",
    "ko": "팔로우도 잊지 마시고요! 다양한 차량들을 소개합니다."
   }

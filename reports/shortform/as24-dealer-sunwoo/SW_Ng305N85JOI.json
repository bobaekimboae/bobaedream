  "graphics": [],
  "transcript": [
   {
    "start": 0.0,
    "end": 3.6,
    "text": "마음만 먹으면 시속 300km로 달릴 수 있는 차,",
    "ko": "마음만 먹으면 시속 300km로 달릴 수 있는 차,"
   },
   {
    "start": 3.6,
    "end": 5.4,
    "text": "저속에서는 전기모드로 주행 가능합니다.",
    "ko": "저속에서는 전기모드로 주행 가능합니다."
   },
   {
    "start": 5.4,
    "end": 8.7,
    "text": "플러그인 하이브리드가 들어간 슈퍼 SUV.",
    "ko": "플러그인 하이브리드가 들어간 슈퍼 SUV."
   },
   {
    "start": 8.7,
    "end": 13.9,
    "text": "합산 출력 800마력 제로백 3.4초의 안녕하세요 우루스 S-E입니다.",
    "ko": "합산 출력 800마력 제로백 3.4초의 안녕하세요 우루스 S-E입니다."
   },
   {
    "start": 13.9,
    "end": 18.2,
    "text": "오렌지 빛깔의 아란치오 아르고스 2450만원짜리 페인트 컬러입니다.",
    "ko": "오렌지 빛깔의 아란치오 아르고스 2450만원짜리 페인트 컬러입니다."
   },
   {
    "start": 18.2,
    "end": 21.3,
    "text": "휠에도 동일한 색으로 악센트를 줬습니다.",
    "ko": "휠에도 동일한 색으로 악센트를 줬습니다."
   },
   {
    "start": 21.3,
    "end": 27.5,
    "text": "전체적인 마감은 카본 대신 하이글로스 블랙 패키지를 적용하여 깔끔하게 멋을 흐르게 했습니다.",
    "ko": "전체적인 마감은 카본 대신 하이글로스 블랙 패키지를 적용하여 깔끔하게 멋을 흐르게 했습니다."
   },
   {
    "start": 27.5,
    "end": 29.8,
    "text": "무려 루프까지 유광으로 마감했지요.",
    "ko": "무려 루프까지 유광으로 마감했지요."
   },
   {
    "start": 29.8,
    "end": 32.8,
    "text": "전작과 비슷한 듯하면서도 바뀐 앞과 뒤.",
    "ko": "전작과 비슷한 듯하면서도 바뀐 앞과 뒤."
   },
   {
    "start": 32.8,
    "end": 35.5,
    "text": "어? 아크라포빅 머플러 아닌가요 이거?",
    "ko": "어? 아크라포빅 머플러 아닌가요 이거?"
   },
   {
    "start": 35.5,
    "end": 40.5,
    "text": "또 풍족한 배기에 석유가 터진듯한 사운드. 이 사운드의 비용은 2900만원 되겠습니다.",
    "ko": "또 풍족한 배기에 석유가 터진듯한 사운드. 이 사운드의 비용은 2900만원 되겠습니다."
   },
   {
    "start": 40.5,
    "end": 46.5,
    "text": "배기음 듣기도 바쁘지만 뱅앤올룹슨 오디오 시스템 추가하셨고요, 960만원 되겠습니다.",
    "ko": "배기음 듣기도 바쁘지만 뱅앤올룹슨 오디오 시스템 추가하셨고요, 960만원 되겠습니다."
   },
   {
    "start": 46.5,
    "end": 55.4,
    "text": "실내도 동일하게 아란치오 계열의 레오니스 컬러로 포인트를 준 스포르티보 레더 인테리어. 성공의 맛.. 오렌지처럼 상큼하네요.",
    "ko": "실내도 동일하게 아란치오 계열의 레오니스 컬러로 포인트를 준 스포르티보 레더 인테리어. 성공의 맛.. 오렌지처럼 상큼하네요."
   },
   {
    "start": 55.4,
    "end": 66.2,
    "text": "베이스 프라이스는 3억 3천만원이지만 옵션으로 1억 3천만원 가량 추가되어 이 차량의 출고 가격은 약 4억 6천만원에 육박합니다.",
    "ko": "베이스 프라이스는 3억 3천만원이지만 옵션으로 1억 3천만원 가량 추가되어 이 차량의 출고 가격은 약 4억 6천만원에 육박합니다."
   },
   {
    "start": 66.2,
    "end": 71.0,
    "text": "굉장하죠? 메인터넌스 패키지와 차량 보증기간은 5년으로 폭넓게 적용된,",
    "ko": "굉장하죠? 메인터넌스 패키지와 차량 보증기간은 5년으로 폭넓게 적용된,"
   },
   {
    "start": 71.0,
    "end": 76.5,
    "text": "이 차량에 대한 자세한 정보는 캡션 또는 프로필 게시물을 확인해 주세요.",
    "ko": "이 차량에 대한 자세한 정보는 캡션 또는 프로필 게시물을 확인해 주세요."
   },
   {
    "start": 76.5,
    "end": 80.1,
    "text": "더 많은 차량을 만나보시려면 팔로우 부탁드립니다.",
    "ko": "더 많은 차량을 만나보시려면 팔로우 부탁드립니다."
   }
  ],

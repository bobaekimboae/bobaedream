  "transcript": [
   {
    "start": 0.0,
    "end": 3.7,
    "text": "De Volkswagen ID.4 versus de Volkswagen ID.7.",
    "ko": "폭스바겐 ID.4 대 폭스바겐 ID.7 비교입니다."
   },
   {
    "start": 3.7,
    "end": 7.5,
    "text": "De ID.7 is sportiever en aerodynamischer in zijn design.",
    "ko": "ID.7은 더 스포티하고 공기역학적인 디자인을 갖췄습니다."
   },
   {
    "start": 7.5,
    "end": 10.7,
    "text": "De ID.7 is uitgevoerd met een 80 kWh batterij.",
    "ko": "ID.7은 80 kWh 용량의 배터리를 탑재했습니다."
   },
   {
    "start": 10.7,
    "end": 13.5,
    "text": "Heeft een rijbereik van 618 km.",
    "ko": "주행거리는 최대 618 km에 달합니다."
   },
   {
    "start": 13.5,
    "end": 16.8,
    "text": "En hij heeft ook 286 pk.",
    "ko": "그리고 최고출력 286마력을 발휘합니다."
   },
   {
    "start": 16.8,
    "end": 19.8,
    "text": "En hij kost €38.990.",
    "ko": "가격은 38,990 유로입니다."
   },
   {
    "start": 19.8,
    "end": 22.8,
    "text": "De ID.4 heeft een hogere instap en zit hoger.",
    "ko": "ID.4는 타고 내리기 편하며 시트 포지션이 높습니다."
   },
   {
    "start": 22.8,
    "end": 25.1,
    "text": "Hij is ook ideaal voor gezinnen.",
    "ko": "패밀리카로도 안성맞춤입니다."
   },
   {
    "start": 25.1,
    "end": 27.7,
    "text": "De ID.4 heeft een batterij van 77 kWh.",
    "ko": "ID.4는 77 kWh 배터리가 장착되어 있습니다."
   },
   {
    "start": 27.7,
    "end": 30.5,
    "text": "En een rijbereik tot 547 km.",
    "ko": "최대 주행거리는 547 km입니다."
   },
   {
    "start": 30.5,
    "end": 32.9,
    "text": "En hij heeft 286 pk.",
    "ko": "최고출력은 286마력입니다."
   },
   {
    "start": 32.9,
    "end": 35.8,
    "text": "De ID.4 kost €34.900.",
    "ko": "ID.4의 가격은 34,900 유로입니다."
   },
   {
    "start": 35.8,
    "end": 40.5,
    "text": "Je vindt ze beide in de showroom van Falcon Automotive en op AutoScout24.be.",
    "ko": "두 모델 모두 Falcon Automotive 쇼룸과 AutoScout24.be에서 만나보실 수 있습니다."
   }
  ],

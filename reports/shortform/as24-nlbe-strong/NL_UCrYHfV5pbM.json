  "transcript": [
   {
    "start": 0.0,
    "end": 4.0,
    "text": "Ik laat je in minder dan een minuut deze Lexus RX 350h zien.",
    "ko": "1분 안에 이 렉서스 RX 350h를 보여드릴게요."
   },
   {
    "start": 4.0,
    "end": 6.2,
    "text": "Hij heeft een Morello Red Metallic kleur.",
    "ko": "모렐로 레드 메탈릭 색상이고요."
   },
   {
    "start": 6.2,
    "end": 8.5,
    "text": "Hij heeft koplampsproeiers, voorparkeersensoren,",
    "ko": "헤드램프 워셔와 전방 주차 센서,"
   },
   {
    "start": 8.5,
    "end": 10.8,
    "text": "achterparkeersensoren en een camera.",
    "ko": "후방 센서와 카메라가 있습니다."
   },
   {
    "start": 10.8,
    "end": 12.0,
    "text": "21-inch velgen.",
    "ko": "21인치 휠."
   },
   {
    "start": 12.0,
    "end": 13.5,
    "text": "Dodehoekdetectie, keyless entry.",
    "ko": "사각지대 감지와 키리스 엔트리."
   },
   {
    "start": 13.5,
    "end": 17.8,
    "text": "Hij heeft een Mark Levinson audiosysteem met 21 speakers.",
    "ko": "21개 스피커의 마크 레빈슨 오디오 시스템이 있습니다."
   },
   {
    "start": 17.8,
    "end": 19.3,
    "text": "Een panoramadak,",
    "ko": "파노라마 선루프,"
   },
   {
    "start": 19.3,
    "end": 20.3,
    "text": "Remote Park Assist,",
    "ko": "원격 주차 보조,"
   },
   {
    "start": 20.3,
    "end": 24.8,
    "text": "elektrisch verstelbare stoelen met geheugen, stoelverwarming en stoelventilatie.",
    "ko": "메모리 기능이 있는 전동 시트, 열선과 통풍 시트도 갖췄습니다."
   },
   {
    "start": 24.8,
    "end": 26.5,
    "text": "Camera in de spiegel,",
    "ko": "룸미러 카메라,"
   },
   {
    "start": 26.5,
    "end": 28.0,
    "text": "een Head-Up Display,",
    "ko": "헤드업 디스플레이,"
   },
   {
    "start": 28.0,
    "end": 32.0,
    "text": "een verwarmd stuur met adaptive cruise control en flippers om te schakelen.",
    "ko": "어댑티브 크루즈 컨트롤과 패들 시프트가 포함된 열선 핸들."
   },
   {
    "start": 32.0,
    "end": 33.3,
    "text": "Wireless charging.",
    "ko": "무선 충전."
   },
   {
    "start": 33.3,
    "end": 36.6,
    "text": "2000 kg trekgewicht, en het is een hybrid zonder stekker.",
    "ko": "견인력은 2000kg이며, 충전기 없는 하이브리드입니다."
   },
   {
    "start": 36.6,
    "end": 40.0,
    "text": "De prijs is... en bouwjaar en de kilometerstand vind je in de omschrijving.",
    "ko": "가격은... 그리고 연식과 주행거리는 더보기란에서 확인하세요."
   },
   {
    "start": 40.0,
    "end": 45.4,
    "text": "En je vindt hem in de showroom van Huro Auto's, en natuurlijk op AutoScout24.nl.",
    "ko": "Huro Auto's 쇼룸과 AutoScout24.nl에서 만나보실 수 있습니다."
   }
  ],

  "transcript": [
   {
    "start": 0.0,
    "end": 3.7,
    "text": "Een auto kopen of verkopen, maar bang voor oplichting?",
    "ko": "차를 사고팔고 싶은데 사기가 두려우신가요?"
   },
   {
    "start": 3.7,
    "end": 6.3,
    "text": "Het grootste risico: de betaling.",
    "ko": "가장 큰 위험은 바로 결제입니다."
   },
   {
    "start": 6.3,
    "end": 9.2,
    "text": "Wie vertrouw je en wanneer betaal je?",
    "ko": "누구를 믿고 언제 돈을 보내야 할까요?"
   },
   {
    "start": 9.2,
    "end": 11.8,
    "text": "Daarom is er Safe Trade van AutoScout24.",
    "ko": "그래서 AutoScout24의 Safe Trade가 있습니다."
   },
   {
    "start": 11.8,
    "end": 15.6,
    "text": "Een veilige manier om auto's te kopen en te verkopen.",
    "ko": "차량을 안전하게 사고파는 방법이죠."
   },
   {
    "start": 15.6,
    "end": 19.3,
    "text": "Je maakt een advertentie of je vindt een auto op AutoScout24.",
    "ko": "광고를 등록하거나 AutoScout24에서 차를 찾으세요."
   },
   {
    "start": 19.3,
    "end": 22.0,
    "text": "Start een Safe Trade transactie en nodig de andere partij uit.",
    "ko": "Safe Trade 거래를 시작하고 상대방을 초대하세요."
   },
   {
    "start": 22.0,
    "end": 24.3,
    "text": "Beide partijen verifiëren hun identiteit.",
    "ko": "양측 모두 신원 인증을 거치게 됩니다."
   },
   {
    "start": 24.3,
    "end": 27.2,
    "text": "De betaling van de koper wordt veilig vastgehouden,",
    "ko": "구매자의 결제 대금은 안전하게 보관되며,"
   },
   {
    "start": 27.2,
    "end": 31.9,
    "text": "en pas wanneer de auto is overgedragen en bevestigd, wordt het geld vrijgegeven aan de verkoper.",
    "ko": "차량이 최종 전달되고 확인된 후에야 판매자에게 대금이 지급됩니다."
   },
   {
    "start": 31.9,
    "end": 34.8,
    "text": "Koop en verkoop met vertrouwen.",
    "ko": "안심하고 거래하세요."
   },
   {
    "start": 34.8,
    "end": 37.6,
    "text": "Gebruik Safe Trade op autoscout24.be.",
    "ko": "autoscout24.be에서 Safe Trade를 이용해 보세요."
   }
  ],

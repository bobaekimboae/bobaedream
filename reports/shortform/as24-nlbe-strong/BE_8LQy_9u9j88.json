  "transcript": [
   {
    "start": 0.0,
    "end": 2.1,
    "text": "Met welke auto ga jij naar het strand?",
    "ko": "어떤 차를 타고 해변에 가실 건가요?"
   },
   {
    "start": 2.1,
    "end": 3.7,
    "text": "Kies jij voor de Fiat Topolino?",
    "ko": "피아트 토폴리노를 선택하시겠습니까?"
   },
   {
    "start": 3.7,
    "end": 6.0,
    "text": "Hij gaat maximaal 45 km/u,",
    "ko": "최고 속도는 45km/h이고,"
   },
   {
    "start": 6.0,
    "end": 7.8,
    "text": "en je laadt hem op binnen 4 uurtjes.",
    "ko": "4시간 만에 완충됩니다."
   },
   {
    "start": 7.8,
    "end": 9.5,
    "text": "Hij komt uit 2025,",
    "ko": "이 차는 2025년식이며,"
   },
   {
    "start": 9.5,
    "end": 12.1,
    "text": "en hij kost €13.900.",
    "ko": "가격은 13,900유로입니다."
   },
   {
    "start": 12.1,
    "end": 14.2,
    "text": "En heb je na een dagje strand vieze voeten?",
    "ko": "해변에서 하루를 보낸 후 발이 더러워졌나요?"
   },
   {
    "start": 14.2,
    "end": 16.6,
    "text": "Daar heeft deze Topolino ook een oplossing voor.",
    "ko": "토폴리노에는 해결책이 있습니다."
   },
   {
    "start": 16.6,
    "end": 19.8,
    "text": "Een kleine minidouche om je voeten af te spoelen.",
    "ko": "발을 씻을 수 있는 작은 미니 샤워기죠."
   },
   {
    "start": 19.8,
    "end": 21.8,
    "text": "Of kies je toch voor de M3 Touring?",
    "ko": "아니면 M3 투어링을 선택하시겠습니까?"
   },
   {
    "start": 21.8,
    "end": 24.3,
    "text": "Onder de kap ligt een 3L twin-turbo 6-in-lijn,",
    "ko": "보닛 아래에는 3.0L 직렬 6기통 트윈터보 엔진이 자리잡고,"
   },
   {
    "start": 24.3,
    "end": 27.8,
    "text": "met 530 pk en 650 Nm koppel.",
    "ko": "530마력과 650Nm의 토크를 발휘합니다."
   },
   {
    "start": 27.8,
    "end": 31.0,
    "text": "En tegelijkertijd heb je 500L aan kofferruimte,",
    "ko": "동시에 500L의 넉넉한 트렁크 공간과,"
   },
   {
    "start": 31.0,
    "end": 33.5,
    "text": "en ruimte voor het hele gezin.",
    "ko": "온 가족을 위한 공간이 마련되어 있습니다."
   },
   {
    "start": 33.5,
    "end": 36.2,
    "text": "Deze BMW M3 Touring komt uit 2026,",
    "ko": "이 BMW M3 투어링은 2026년식 모델로,"
   },
   {
    "start": 36.2,
    "end": 39.5,
    "text": "heeft 6.211 km gereden,",
    "ko": "주행거리는 6,211km이며,"
   },
   {
    "start": 39.5,
    "end": 42.1,
    "text": "en hij kost €102.900.",
    "ko": "가격은 102,900유로입니다."
   },
   {
    "start": 42.1,
    "end": 44.5,
    "text": "Je vindt ze bij Auto-Point Casier,",
    "ko": "Auto-Point Casier에서 만나보실 수 있으며,"
   },
   {
    "start": 44.5,
    "end": 46.5,
    "text": "en op AutoScout24.be.",
    "ko": "AutoScout24.be에서도 확인하실 수 있습니다."
   }

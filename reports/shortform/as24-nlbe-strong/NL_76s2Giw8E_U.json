  "transcript": [
   {
    "start": 0.0,
    "end": 2.8,
    "text": "Kan jij raden hoeveel pk deze Porsche 911 heeft?",
    "ko": "이 포르쉐 911이 몇 마력인지 맞힐 수 있나요?"
   },
   {
    "start": 2.8,
    "end": 6.6,
    "text": "Alleen al de opties op deze auto kosten €40.000.",
    "ko": "이 차에 들어간 옵션 가격만 해도 4만 유로입니다."
   },
   {
    "start": 6.6,
    "end": 9.4,
    "text": "En dat zijn onder andere achterasbesturing,",
    "ko": "그중에는 후륜 조향과,"
   },
   {
    "start": 9.4,
    "end": 10.7,
    "text": "frontlift,",
    "ko": "프론트 리프트,"
   },
   {
    "start": 10.7,
    "end": 12.3,
    "text": "de LED-matrixkoplampen,",
    "ko": "LED 매트릭스 헤드램프,"
   },
   {
    "start": 12.3,
    "end": 14.8,
    "text": "en een handgeschakelde 7-versnellingsbak.",
    "ko": "그리고 7단 수동변속기가 포함되어 있습니다."
   },
   {
    "start": 14.8,
    "end": 18.7,
    "text": "En hij komt uit 2021 en heeft slechts 13.000 km gelopen.",
    "ko": "2021년식이며 주행거리는 13,000km에 불과합니다."
   },
   {
    "start": 18.7,
    "end": 22.4,
    "text": "En de prijs van deze Porsche is €139.950.",
    "ko": "그리고 이 포르쉐의 가격은 139,950유로입니다."
   },
   {
    "start": 22.4,
    "end": 26.5,
    "text": "En nu ben ik benieuwd of jij kan raden hoeveel pk deze Porsche heeft?",
    "ko": "이제 여러분이 이 포르쉐의 마력을 맞힐 수 있을지 궁금하네요?"
   },
   {
    "start": 26.5,
    "end": 29.5,
    "text": "Laat het even weten in een reactie en vergeet ons niet te volgen.",
    "ko": "댓글로 알려주시고 팔로우도 잊지 마세요."
   }

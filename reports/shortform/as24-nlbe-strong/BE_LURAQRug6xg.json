  "transcript": [
   {
    "start": 0.0,
    "end": 1.5,
    "text": "Een snelle gezinsauto?",
    "ko": "빠른 패밀리카?"
   },
   {
    "start": 1.5,
    "end": 3.8,
    "text": "Dat is de BMW M3 Touring.",
    "ko": "그건 바로 BMW M3 투어링입니다."
   },
   {
    "start": 3.8,
    "end": 6.8,
    "text": "En wat die kost, dat vertel ik je op het einde.",
    "ko": "가격은 마지막에 알려드릴게요."
   },
   {
    "start": 6.8,
    "end": 10.7,
    "text": "Onder de kap ligt een 3L twin-turbo zes-in-lijn.",
    "ko": "보닛 아래에는 3.0리터 트윈터보 직렬 6기통 엔진이 탑재되어 있고,"
   },
   {
    "start": 10.7,
    "end": 13.5,
    "text": "Goed van 0 tot 100 in 3,6 seconden,",
    "ko": "0에서 100km/h까지 3.6초만에 도달하며,"
   },
   {
    "start": 13.5,
    "end": 16.9,
    "text": "met 530 PK en 650 Nm koppel.",
    "ko": "530마력과 650Nm 토크를 발휘합니다."
   },
   {
    "start": 16.9,
    "end": 20.3,
    "text": "En tegelijkertijd heb je 500L aan kofferruimte,",
    "ko": "그리고 동시에 500L의 트렁크 공간이 있고,"
   },
   {
    "start": 20.3,
    "end": 22.4,
    "text": "en ruimte voor het hele gezin.",
    "ko": "온 가족을 위한 넓은 공간도 마련되어 있죠."
   },
   {
    "start": 22.4,
    "end": 26.6,
    "text": "Dus je kan de kinderen naar school brengen, of lekker gaan shoppen.",
    "ko": "아이들을 학교에 데려다주거나 여유롭게 쇼핑하러 갈 수도 있죠."
   },
   {
    "start": 26.6,
    "end": 28.0,
    "text": "En je krijgt er een leuk geluid bij.",
    "ko": "그리고 멋진 사운드까지 덤으로 얻을 수 있습니다."
   },
   {
    "start": 33.0,
    "end": 36.4,
    "text": "Deze BMW M3 Touring komt uit 2023,",
    "ko": "이 BMW M3 투어링은 2023년식으로,"
   },
   {
    "start": 36.4,
    "end": 39.5,
    "text": "heeft 6211 km gereden,",
    "ko": "주행거리는 6,211km이고,"
   },
   {
    "start": 39.5,
    "end": 41.7,
    "text": "en hij kost €102.900.",
    "ko": "가격은 102,900 유로입니다."
   },
   {
    "start": 41.7,
    "end": 44.8,
    "text": "Je vindt hem in de showroom van Auto-Point Casier,",
    "ko": "Auto-Point Casier 쇼룸에서 만나보실 수 있으며,"
   },
   {
    "start": 44.8,
    "end": 47.6,
    "text": "en op autoscout24.be.",
    "ko": "AutoScout24.be에서도 확인하실 수 있습니다."

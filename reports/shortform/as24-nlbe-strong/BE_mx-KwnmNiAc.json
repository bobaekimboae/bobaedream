  "transcript": [
   {
    "start": 0.0,
    "end": 2.3,
    "text": "Gezinswagen nodig voor onder de twintigduizend euro?",
    "ko": "2만 유로 이하 패밀리카가 필요하신가요?"
   },
   {
    "start": 2.3,
    "end": 4.5,
    "text": "En met minder dan 100.000 km?",
    "ko": "그리고 주행거리 10만 km 미만으로요?"
   },
   {
    "start": 4.5,
    "end": 7.0,
    "text": "Dit is de Ford Focus Clipper.",
    "ko": "이 차가 바로 포드 포커스 클리퍼입니다."
   },
   {
    "start": 7.0,
    "end": 8.7,
    "text": "En hij is uitgevoerd met bomvol opties, kom maar mee!",
    "ko": "옵션이 가득 차 있어요, 같이 보시죠!"
   },
   {
    "start": 8.7,
    "end": 10.8,
    "text": "Keyless entry, adaptive cruise control en lane assist,",
    "ko": "키리스 엔트리, 어댑티브 크루즈 컨트롤과 차선 유지 보조,"
   },
   {
    "start": 10.8,
    "end": 13.2,
    "text": "stoelverwarming en voorruitverwarming,",
    "ko": "시트 열선과 앞유리 열선,"
   },
   {
    "start": 13.2,
    "end": 14.8,
    "text": "verkeersbordherkenning,",
    "ko": "교통 표지판 인식,"
   },
   {
    "start": 14.8,
    "end": 18.7,
    "text": "verschillende rijstanden: Normaal, Eco en Sport,",
    "ko": "다양한 주행 모드: 노멀, 에코, 스포츠,"
   },
   {
    "start": 18.7,
    "end": 19.8,
    "text": "achteruitrijcamera,",
    "ko": "후방 카메라,"
   },
   {
    "start": 19.8,
    "end": 22.0,
    "text": "en genoeg ruimte voor het hele gezin.",
    "ko": "온 가족이 타기에 넉넉한 공간."
   },
   {
    "start": 22.0,
    "end": 23.6,
    "text": "Bekerhouders en een skiluilk,",
    "ko": "컵홀더와 스키 스루 도어,"
   },
   {
    "start": 23.6,
    "end": 26.6,
    "text": "een elektrische kofferklep met zoveel ruimte, perfect voor een roadtrip.",
    "ko": "전동 트렁크와 넓은 적재 공간, 로드트립에 딱이죠."
   },
   {
    "start": 26.6,
    "end": 28.9,
    "text": "Hij komt uit 2022,",
    "ko": "2022년식이고,"
   },
   {
    "start": 28.9,
    "end": 31.7,
    "text": "heeft 99.500 km,",
    "ko": "주행거리는 99,500km,"
   },
   {
    "start": 31.7,
    "end": 33.7,
    "text": "en hij kost €15.900.",
    "ko": "그리고 가격은 15,900유로입니다."
   },
   {
    "start": 33.7,
    "end": 38.8,
    "text": "Je vindt hem bij Autoswitch en op AutoScout24.be.",
    "ko": "Autoswitch 딜러 및 AutoScout24.be에서 만나보실 수 있습니다."
   }

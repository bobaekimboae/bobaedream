  {
   "a": 24.85,
   "b": 26.56,
   "at": 24.0,
   "text": "운전석은 전동 시트입니다"
  },
  {
   "a": 27.03,
   "b": 28.79,
   "at": 28.0,
   "text": "스티어링 휠은 M 스포츠"
  },
  {
   "a": 29.18,
   "b": 31.97,
   "at": 33.4,
   "text": "헤드업 디스플레이에 디지털 계기판까지 들어가요"
  },
  {
   "a": 32.4,
   "b": 34.84,
   "at": 41.2,
   "text": "가운데 디스플레이로 내비게이션을 보고"

 "sentences": [
  {
   "a": 0,
   "b": 2.45,
   "at": 0.1,
   "text": "아이고야 카니발 떴데이"
  },
  {
   "a": 2.56,
   "b": 5.75,
   "at": 2.7,
   "text": "2024년 8월에 등록한 그래비티다"
  },
  {
   "a": 5.95,
   "b": 8.48,
   "at": 5.9,
   "text": "눈은 LED라 번쩍번쩍하고"
  },
  {
   "a": 8.58,
   "b": 10.88,
   "at": 9.3,
   "text": "신발은 시커먼 휠 신었네"
  },
  {
   "a": 11.1,
   "b": 14.25,
   "at": 11.9,
   "text": "트렁크는 지 혼자 열린다 손 안 대도 된다"
  },
  {
   "a": 14.46,
   "b": 17.74,
   "at": 16.3,
   "text": "아홉 명 탄데이 시댁 식구 다 태아도 된다"
  },
  {
   "a": 17.95,
   "b": 21.07,
   "at": 20.6,
   "text": "옆문 열면 2열은 의자가 따로따로다"
  },
  {
   "a": 21.42,
   "b": 24.88,
   "at": 24.2,
   "text": "시트는 밝은 베이지라 과자 흘리면 다 보인데이"
  },
  {
   "a": 25.1,
   "b": 28.84,
   "at": 27.7,
   "text": "기어는 동글뱅이 돌리는 기고 컵 꽂는 데도 두 개"
  },
  {
   "a": 29.3,
   "b": 32.25,
   "at": 35.2,
   "text": "계기판에는 옆 차선이 테레비처럼 나온다 아이가"
  },
  {
   "a": 32.42,
   "b": 36.69,
   "at": 40.3,
   "text": "버튼은 와 이래 많노 그래도 화면은 큼지막하다"
  },
  {
   "a": 37.14,
   "b": 40.84,
   "at": 48.4,
   "text": "주차는 걱정 마라 카메라가 차를 위에서 비춰 준다"
  },
  {
   "a": 41.06,
   "b": 44.4,
   "at": 53.6,
   "text": "사고 이력은 보배드림에서 보고 퍼뜩 온나"
  }
 ],

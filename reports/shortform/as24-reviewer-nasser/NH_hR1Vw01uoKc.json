  "transcript": [
   {
    "start": 0.8,
    "end": 3.0,
    "text": "أنت جايبني على ملا وشي ليه يعم أنت!",
    "ko": "날 왜 이렇게 급하게 부른 거야 이 사람아!"
   },
   {
    "start": 3.2,
    "end": 5.0,
    "text": "انزلي بسرعة في واحد محتاج 3 إسكاليد ضروري",
    "ko": "빨리 내려봐, 급하게 캐딜락 에스컬레이드 3대 찾는 고객이 있어"
   },
   {
    "start": 5.2,
    "end": 8.0,
    "text": "عندي خمسة، بس مين اللي عايز ثلاثة ده؟",
    "ko": "난 5대나 있는데, 3대나 찾는 그 사람은 누구야?"
   },
   {
    "start": 10.0,
    "end": 13.0,
    "text": "تعال نستفتح بالـ V أصل الباشا بيحب السواقة أوي",
    "ko": "먼저 V 모델로 시작하자, 그분이 드라이빙을 엄청 좋아하거든"
   },
   {
    "start": 13.2,
    "end": 16.5,
    "text": "سهلة، دوس يا جلال.. كفاية يا جلال!",
    "ko": "간단하지, 밟아봐 잘랄! ..그만 밟아 잘랄!"
   },
   {
    "start": 17.0,
    "end": 21.5,
    "text": "الماتور ده 8 سلندر 6200 سي سي سوبرتشارجر 680 حصان",
    "ko": "이 엔진은 V8 6,200cc 수퍼차저 682마력이야"
   },
   {
    "start": 23.5,
    "end": 27.0,
    "text": "كاربون فايبر في كل حتة والفرش أبيض وشاشات كمان",
    "ko": "카본파이버 트림 도배에 화이트 시트, 디스플레이까지 다 있어"
   },
   {
    "start": 29.0,
    "end": 31.5,
    "text": "عايز واحدة Long عشان الباشا عيلته كبيرة",
    "ko": "가족이 대가족이라 롱바디도 한 대 필요해"
   },
   {
    "start": 32.5,
    "end": 36.5,
    "text": "شد الأكرة كدة والباب بتاعك هيقفل، وتقدر تقفله من الشاشة",
    "ko": "손잡이를 살짝 당기면 전동으로 문이 닫히고 화면에서도 닫을 수 있어"
   },
   {
    "start": 37.0,
    "end": 42.0,
    "text": "وعندك ترابيزة، والصف التالت لوحده أوسع من البوكستر بتاعتي",
    "ko": "접이식 테이블에다 3열은 내 포르쉐 박스터 전체보다 더 넓어"
   },
   {
    "start": 46.5,
    "end": 54.0,
    "text": "ثلاجة، وشاشة 55 بوصة والمراية قالبيناها كاميرا",
    "ko": "냉장고에 55인치 스크린, 룸미러는 디지털 카메라 뷰 지원이야"
   },
   {
    "start": 56.0,
    "end": 58.5,
    "text": "شفلي بقى أجمد حاجة عندك عشان لسة رايح أخلص في 7 فيراري",
    "ko": "너한테 있는 것 중 끝판왕 보여줘, 나 페라리 7대 계약하러 가야 돼"
   },
   {
    "start": 58.5,
    "end": 60.0,
    "text": "تبقى الـ VIP Edition اتفضل",
    "ko": "그럼 VIP 에디션이지, 어서 타봐"
   },
   {
    "start": 60.5,
    "end": 67.0,
    "text": "ستار لايت، ستاير، تسخين، تبريد، مساج، أكل، شرب.. دلع!",
    "ko": "스타라이트 천장, 전동 커튼, 통풍, 열선, 안마, 식음료 테이블까지 완벽해!"
   },
   {
    "start": 108.0,
    "end": 114.5,
    "text": "تلفزيون وبلايستيشن وثلاجة وكراسي نوم وماكينة قهوة",
    "ko": "대형 TV에 플레이스테이션5, 냉장고, 침대형 리클라이닝 시트에 커피머신까지"
   },
   {
    "start": 116.5,
    "end": 121.5,
    "text": "من التابلت تقدر تفتح الكرسيين دول",
    "ko": "태블릿 터치 하나로 이 접이식 시트 2개를 펴낼 수 있어"
   },
   {
    "start": 130.0,
    "end": 138.0,
    "text": "العنوان: أوتو ستاد بنزينة تشيل أوت AUC، شركة استيراد متخصصة في اللاكجري",
    "ko": "위치는 칠아웃 AUC 주유소 오토 스태드 전시황, 럭셔리 직수입 전문점이야"
   }

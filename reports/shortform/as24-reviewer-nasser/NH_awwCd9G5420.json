  "transcript": [
   {
    "start": 0.0,
    "end": 2.2,
    "text": "بارتفاع قرب ال 30 سم وبطول أكثر من 4 م",
    "ko": "약 30cm에 가까운 지상고와 4m가 넘는 전장"
   },
   {
    "start": 2.2,
    "end": 5.6,
    "text": "تحت ال 2 مليون دي أكثر 7 راكب عجبتني شيري تيجو 9",
    "ko": "2백만 이하에서 제가 가장 마음에 든 7인승, 체리 티고 9입니다"
   },
   {
    "start": 5.6,
    "end": 11.0,
    "text": "وتشطيب سوبر لوكس عندك ساوند سيستم من سوني خامات العربية فخمة جدا",
    "ko": "슈퍼 럭셔리 마감, 소니 사운드 시스템에 고급스러운 소재들까지"
   },
   {
    "start": 11.0,
    "end": 14.5,
    "text": "وايرلس أبل كاربلاي وأندرويد أوتو وشاحن وايرلس سريع",
    "ko": "무선 애플 카플레이, 안드로이드 오토에 고속 무선 충전까지"
   },
   {
    "start": 14.5,
    "end": 18.0,
    "text": "وعشان الأمان أهم حاجة عندك إيرباجز وأنظمة فرامل",
    "ko": "그리고 안전이 가장 중요하니까, 에어백과 제동 시스템들"
   },
   {
    "start": 18.0,
    "end": 23.0,
    "text": "ما بتمشيش غير لما تركب الحزام في الكرسي اللي فيه تسخين وتبريد وليج إكستنشن ودلع",
    "ko": "통풍, 열선, 레그 익스텐션까지 들어간 시트는 안전벨트를 매야만 움직입니다"
   },
   {
    "start": 23.0,
    "end": 26.2,
    "text": "وعشان النور يخش عندك سقف بانوراما عملاق",
    "ko": "채광을 위해 거대한 파노라마 선루프도 있습니다"
   },
   {
    "start": 26.2,
    "end": 31.0,
    "text": "تقدر تظبط الكرسي براحتك وستائر عشان الخصوصية",
    "ko": "원하는 대로 시트를 조절하고 프라이버시를 위한 선쉐이드까지"
   },
   {
    "start": 31.0,
    "end": 36.3,
    "text": "وفيها مساحات أكثر من 2000 لتر عشان لو طردوك من البيت تقدر تعيش فيها",
    "ko": "2000리터가 넘는 적재공간으로 집에서 쫓겨나도 여기서 살 수 있습니다"
   },
   {
    "start": 36.3,
    "end": 39.0,
    "text": "ففيها صف ثالث وتشيل 7 فرقة كورة يد",
    "ko": "3열 시트가 있어 핸드볼 한 팀인 7명이 탈 수 있습니다"
   },
   {
    "start": 39.0,
    "end": 44.5,
    "text": "أوكر بوب أوت وبلايند سبوت وكاميرات 360 وجنط جميل مقاس 20",
    "ko": "팝업 도어핸들, 사각지대 감지, 360도 카메라와 예쁜 20인치 휠"
   },
   {
    "start": 44.5,
    "end": 48.9,
    "text": "وبلاج إن هايبريد يعني بطارية كهرباء بتحسن الأداء وتوفر في البنزين",
    "ko": "플러그인 하이브리드로 성능을 높이고 기름값을 아껴줍니다"
   },
   {
    "start": 48.9,
    "end": 53.6,
    "text": "وخلاها توصل لأكثر من 1000 كيلو رينج واستهلاك البنزين من 5 ل 7 لتر في ال 100 كيلو",
    "ko": "총 1000km 이상의 주행거리와 100km당 5~7리터의 연비를 자랑합니다"
   },
   {
    "start": 53.6,
    "end": 57.0,
    "text": "وبكده تيجو 9 أحسن عربية تتحرك وتعيش فيها",
    "ko": "이렇듯 티고 9은 타고 다니며 살기에도 최고의 차입니다"
   }
  ],

  "transcript": [
   {
    "start": 0.0,
    "end": 2.5,
    "text": "أنا ناصر وبتصميم رياضي جداً Forthing T5 EVO",
    "ko": "저는 나사르입니다. 아주 스포티한 디자인의 포씽 T5 EVO입니다."
   },
   {
    "start": 2.6,
    "end": 5.3,
    "text": "زي ما بقولك رياضية جداً عندك بلاك ريمز",
    "ko": "말씀드린 대로 아주 스포티하죠. 블랙 휠이 들어가 있고요."
   },
   {
    "start": 5.4,
    "end": 7.3,
    "text": "DRLs الجديدة والكبوت مسحوب جداً",
    "ko": "새로운 DRL과 길게 뻗은 보닛 라인,"
   },
   {
    "start": 7.4,
    "end": 10.0,
    "text": "وفتحات تهوية كبيرة للموتور",
    "ko": "그리고 엔진을 위한 커다란 흡기구가 있습니다."
   },
   {
    "start": 10.1,
    "end": 14.4,
    "text": "وموتور 1500 تيربو 195 حصان و285 نيوتن متوصلين بـ",
    "ko": "1500cc 터보 엔진으로 195마력과 285Nm를 발휘하며,"
   },
   {
    "start": 14.5,
    "end": 16.4,
    "text": "فتيس DCT مبلل عشان عمره يزيد",
    "ko": "내구성을 높인 습식 DCT 변속기가 맞물립니다."
   },
   {
    "start": 16.5,
    "end": 18.6,
    "text": "وجوه عندك سقف بانوراما",
    "ko": "실내에는 파노라마 선루프가 있고,"
   },
   {
    "start": 18.7,
    "end": 20.2,
    "text": "الكراسي بتاعتك كهربا",
    "ko": "전동 시트가 적용되었습니다."
   },
   {
    "start": 20.3,
    "end": 23.8,
    "text": "سوفت تاتش ع التابلوه ودبل سكرين فيها آبل كاربلاي وأندرويد أوتو",
    "ko": "대시보드는 소프트 터치 마감에 애플 카플레이와 안드로이드 오토를 지원하는 더블 스크린,"
   },
   {
    "start": 23.9,
    "end": 25.7,
    "text": "دريكسيون مالتي فانكشن بأدابتف كروز كنترول",
    "ko": "어댑티브 크루즈 컨트롤이 들어간 멀티펑션 스티어링 휠,"
   },
   {
    "start": 25.8,
    "end": 28.4,
    "text": "تحكم في التكييف ومخرج شاحن واتنين كاب هولدرز",
    "ko": "공조 제어 장치와 충전 포트, 두 개의 컵홀더가 있습니다."
   },
   {
    "start": 28.5,
    "end": 30.1,
    "text": "من ورا البانوراما مكمل وعندك مسند للإيد",
    "ko": "뒷좌석까지 선루프가 이어지며 암레스트가 있고,"
   },
   {
    "start": 30.2,
    "end": 33.0,
    "text": "وتقدر تتحكم في الكرسي اللي قدامك مكان للأكياس",
    "ko": "앞좌석을 조절하는 워크인 스위치와 쇼핑백 걸이,"
   },
   {
    "start": 33.1,
    "end": 36.1,
    "text": "فتحات تكييف ومخرج شاحن واحد ومش تايب سي كمان",
    "ko": "에어컨 송풍구와 충전 포트(Type-C는 아님)가 들어갑니다."
   },
   {
    "start": 36.2,
    "end": 37.4,
    "text": "ومش تايب سي كمان",
    "ko": "C타입이 아닌 점은 아쉽네요."
   },
   {
    "start": 37.5,
    "end": 39.4,
    "text": "برا كل المقاييس هي أحلى شكل في الفئة",
    "ko": "전체적으로 동급 세그먼트 중 가장 예쁜 디자인입니다."
   },
   {
    "start": 39.5,
    "end": 41.4,
    "text": "عندك لايت بار شكله خطير لمسات رياضية",
    "ko": "멋진 일체형 리어 라이트바와 스포티한 디테일,"
   },
   {
    "start": 41.5,
    "end": 44.4,
    "text": "أربع فتحات إكزوست حقيقيين بس ملهمش صوت بس الشنطة كهربا",
    "ko": "진짜 4구 배기구가 있지만 배기음은 조용하며, 전동 트렁크가 적용됩니다."
   },
   {
    "start": 44.5,
    "end": 48.0,
    "text": "وتشيل معاك وكمان كراسيها بتنزل وتقدر تغطيها",
    "ko": "적재공간이 넓고 2열 폴딩과 러기지 스크린도 갖췄습니다."
   },
   {
    "start": 48.1,
    "end": 50.9,
    "text": "ولكل الشركات نقلت البلايند سبوت من هنا لهنا عبقرية",
    "ko": "사각지대 경고등을 거울 바깥쪽으로 옮긴 건 정말 똑똑한 발상이죠."
   },
   {
    "start": 51.0,
    "end": 53.6,
    "text": "وبضمان خمس سنين أو 150 ألف كيلو",
    "ko": "5년 또는 15만 km 보증에,"
   },
   {
    "start": 53.7,
    "end": 56.0,
    "text": "وسيرفيس باكيدج تلات سنين أو 50 ألف كيلو",
    "ko": "3년 또는 5만 km 무상 정비 패키지를 제공합니다."
   },
   {
    "start": 56.1,
    "end": 59.0,
    "text": "اتصلوا على 19413 زائد سنة تأمين",
    "ko": "19413으로 문의하세요, 1년 보험도 추가 제공됩니다."
   }

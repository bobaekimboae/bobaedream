  "transcript": [
   {
    "start": 0.0,
    "end": 2.6,
    "text": "لو عايز عربيه نيسان جبت لك مكان واحد يعمل لك كل حاجه",
    "ko": "닛산 차를 원하신다면, 모든 것을 다 해결해 주는 단 하나의 장소를 알려드립니다."
   },
   {
    "start": 2.7,
    "end": 5.8,
    "text": "وهدان اوتو موزع معتمد وخبره 50 سنه في مجال السيارات",
    "ko": "와흐단 오토는 공인 딜러이자 자동차 분야에서 50년의 경력을 자랑합니다."
   },
   {
    "start": 5.9,
    "end": 8.0,
    "text": "فتح صاله عرض متخصصه في عربيات نيسان",
    "ko": "닛산 차량 전문 쇼룸을 새롭게 오픈했습니다."
   },
   {
    "start": 8.1,
    "end": 11.9,
    "text": "وعندهم من اول النيسان الماجنايت لحد اكبر عربيه في نيسان الباترول",
    "ko": "닛산 마그나이트부터 닛산에서 가장 큰 대형 SUV 패트롤까지 구비되어 있습니다."
   },
   {
    "start": 12.0,
    "end": 15.5,
    "text": "كمان طوروا مركز الخدمه اللي في النزهه بقى 1800 متر",
    "ko": "또한 엘 노즈하 서비스 센터를 1,800m² 규모로 확장 개편했습니다."
   },
   {
    "start": 15.6,
    "end": 18.8,
    "text": "كمان تقدر تيجي وتكشف على العربيه مجانا وتعمل كل صياناتك الدوريه",
    "ko": "무료 점검을 받을 수 있으며 정기 정비도 모두 처리 가능합니다."
   },
   {
    "start": 18.9,
    "end": 21.6,
    "text": "حتى السمكره والدهان كله في نفس المكان",
    "ko": "판금 도장 작업까지 한 곳에서 완벽하게 진행됩니다."
   },
   {
    "start": 21.7,
    "end": 24.8,
    "text": "وبتعمل بايدي مهندسين وصنايعيه معتمدين باعلى كفاءه",
    "ko": "공인된 최고 수준의 전문 엔지니어와 기술진들이 작업합니다."
   },
   {
    "start": 24.9,
    "end": 29.8,
    "text": "ولو عطلت على الطريق بيبعت لك عربيه يا تصلحها لك يا تجيبك المركز وتتفرج على عربيتك وهي بتتصين",
    "ko": "도로에서 고장 나더라도 출동 서비스를 보내 수리해 주거나 센터로 견인해 수리 전 과정을 직접 볼 수 있습니다."
   },
   {
    "start": 29.9,
    "end": 33.7,
    "text": "وكل خدمات البيع والصيانه وقطع الغيار وجهه واحده متكامله",
    "ko": "신차 구매, 정비, 순정 부품까지 원스톱 종합 서비스입니다."
   },
   {
    "start": 33.8,
    "end": 37.7,
    "text": "حتى التامين على العربيه والسواق والضمان الممتد بيتعملوا لك وانت قاعد",
    "ko": "차량 및 운전자 보험, 보증 연장까지 편안히 앉아 계시면 해결됩니다."
   },
   {
    "start": 37.8,
    "end": 42.1,
    "text": "وهدان بقى لهم 10 سنين في شراكه مع نيسان وهما موزعين لبراندات ثانيه كثير",
    "ko": "와흐단은 닛산과 10년째 파트너십을 맺고 있으며 다른 다양한 브랜드도 취급합니다."
   },
   {
    "start": 42.2,
    "end": 46.5,
    "text": "من الاخر لو عايز مكان واحد تخلص فيه كل حاجات عربيتك تعال وهدان",
    "ko": "결론적으로, 차에 관한 모든 문제를 한곳에서 끝내고 싶다면 와흐단으로 오세요!"
   }

  "transcript": [
   {
    "start": 0.0,
    "end": 2.8,
    "text": "لما بنيجي نروح الساحل بتقابلنا مشكلة كبيرة.. هننقل حاجتنا إزاي؟",
    "ko": "북부 해안 휴양지에 갈 때 큰 문제에 부딪히죠.. 짐을 어떻게 옮길까요?"
   },
   {
    "start": 2.8,
    "end": 6.8,
    "text": "بالذات البيتش باجيز، الموتوسيكلات، الجولف كارز، وحتى عربيات باقي البيت.",
    "ko": "특히 비치 버기, 모터사이클, 골프 카트, 그리고 집안의 다른 차량들까지요."
   },
   {
    "start": 6.8,
    "end": 12.8,
    "text": "تطبيق نقلة حلالك كل ده.. عندهم خدمة اسمها Sahel Express معمولة مخصوص.",
    "ko": "Naqla 앱이 이 모든 걸 해결해줍니다. 'Sahel Express'라는 전용 서비스를 제공하죠."
   },
   {
    "start": 12.8,
    "end": 17.5,
    "text": "عشان ينقلهملك من قدام بيتك في الساحل لبيتك في القاهرة.",
    "ko": "사헬의 집 앞에서 카이로의 집까지 그대로 옮겨줍니다."
   },
   {
    "start": 17.6,
    "end": 22.0,
    "text": "وعندهم خدمة Shared Service توفر لحد 75%.",
    "ko": "공유 운송 서비스를 이용하면 최대 75%까지 절약할 수 있습니다."
   },
   {
    "start": 24.6,
    "end": 28.5,
    "text": "الميزة هنا إنك بتنقل من غير أفورة السعر ومش هتتخانق مع السواقين.",
    "ko": "바가지 요금도 없고 기사들과 일정 문제로 다툴 필요도 없습니다."
   },
   {
    "start": 30.6,
    "end": 35.8,
    "text": "عندك تأمين على كل حاجة والدفع Pre-paid.",
    "ko": "모든 것에 보험이 적용되고 선결제 방식으로 현금 걱정이 없습니다."
   },
   {
    "start": 35.8,
    "end": 40.7,
    "text": "وعندهم خدمة تانية لو عربيتك عطلت تقدر تطلب ونش.",
    "ko": "차량이 고장 났을 때는 윈치 견인차 서비스도 호출할 수 있습니다."
   },
   {
    "start": 40.8,
    "end": 46.5,
    "text": "نزل أبلكيشن نقلة دلوقتي.. لو هتنقل أي حاجة لأي حتة هتستخدم نقلة.",
    "ko": "지금 Naqla 앱을 다운로드하세요. 어디로든 무엇을 옮기든 Naqla를 이용해보세요."
   }

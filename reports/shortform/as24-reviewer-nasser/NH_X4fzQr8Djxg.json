  "transcript": [
   {
    "start": 0.0,
    "end": 2.8,
    "text": "أنا ناصر والعربية دي تعريف قيمة مقابل سعر",
    "ko": "저는 나사르입니다. 이 차는 가성비 그 자체입니다."
   },
   {
    "start": 2.8,
    "end": 4.1,
    "text": "لينك آند كو 08",
    "ko": "링크앤코 08."
   },
   {
    "start": 4.1,
    "end": 6.3,
    "text": "لينك آند كو عربية صيني موجهة للسوق الأوروبي",
    "ko": "링크앤코는 유럽 시장을 겨냥한 중국 브랜드 차입니다."
   },
   {
    "start": 6.3,
    "end": 8.7,
    "text": "عشان الأمان واخدة خمس نجوم في اليورو إنكاب",
    "ko": "안전을 위해 유로 NCAP에서 별 5개를 받았습니다."
   },
   {
    "start": 8.7,
    "end": 11.5,
    "text": "ومركز التطوير والأبحاث موجود في السويد يعني تعليم أجنبي",
    "ko": "연구개발 센터가 스웨덴에 있어 유럽 엔지니어링이 적용됐죠."
   },
   {
    "start": 11.5,
    "end": 14.5,
    "text": "عليها موتور 1500 تيربو وبطارية بيخرجوا مع بعض",
    "ko": "1500cc 터보 엔진과 배터리가 결합되어"
   },
   {
    "start": 14.5,
    "end": 16.5,
    "text": "345 حصان و 580 نيوتن",
    "ko": "345마력과 580토크를 냅니다."
   },
   {
    "start": 16.5,
    "end": 19.5,
    "text": "وبنظام البلاج إن هايبرد وسواء البطارية مشحونة أو لا",
    "ko": "플러그인 하이브리드 방식으로 배터리 충전 여부와 상관없이,"
   },
   {
    "start": 19.5,
    "end": 22.0,
    "text": "أداء الموتور كويس جداً بس بتفرق في استهلاك البنزين",
    "ko": "엔진 성능은 훌륭하지만 연비 차이는 있습니다."
   },
   {
    "start": 22.0,
    "end": 25.4,
    "text": "الكنبة واسعة ومريحة، مساحة الرجلين والراس كويسين جداً",
    "ko": "뒷좌석은 넓고 안락하며 레그룸과 헤드룸도 충분합니다."
   },
   {
    "start": 25.4,
    "end": 27.8,
    "text": "الباب بيفتح بزرار ولو الكهربا فصلت بتشد دي",
    "ko": "문은 버튼으로 열리고, 방전되면 이 수동 레버를 당깁니다."
   },
   {
    "start": 27.8,
    "end": 32.1,
    "text": "عندك شنطة كهربا واسعة جداً وسب ووفر عشان لو هتقعدوا فيها بالليل",
    "ko": "넓은 전동 트렁크와 밤에 쉴 때 좋은 서브우퍼가 있습니다."
   },
   {
    "start": 32.1,
    "end": 35.1,
    "text": "ومن قدام حلوة جداً، عندك لون برونزي يخطف الأنظار",
    "ko": "앞모습도 눈길을 사로잡는 브론즈 컬러로 예쁩니다."
   },
   {
    "start": 35.1,
    "end": 37.6,
    "text": "كريستال DRLs و HD Matrix ينورولك الطريق",
    "ko": "크리스탈 DRL과 HD 매트릭스가 길을 환하게 밝힙니다."
   },
   {
    "start": 37.6,
    "end": 41.0,
    "text": "23 سماعة من هارمن كاردون بينوروا",
    "ko": "앰비언트 라이트가 연동되는 23개의 하만카돈 스피커."
   },
   {
    "start": 41.0,
    "end": 45.6,
    "text": "أبل كاربلاي وأندرويد أوتو وشاحن وايرلس ومساحة تخزين وكاب هولدرز وواحدة كمان",
    "ko": "애플 카플레이, 안드로이드 오토, 무선충전기, 콘솔 수납함과 컵홀더."
   },
   {
    "start": 45.6,
    "end": 47.9,
    "text": "عندك سنسور عشان يراقب انتباهك والدريكسيون بتاعك تسخين",
    "ko": "운전자 주의 모니터링 센서와 열선 스티어링 휠이 있고,"
   },
   {
    "start": 47.9,
    "end": 49.9,
    "text": "المراية طايرة و Blind Spot Assist",
    "ko": "플로팅 사이드미러와 사각지대 어시스트도 지원합니다."
   },
   {
    "start": 49.9,
    "end": 53.4,
    "text": "فيها كل حاجة عندك سقف بانوراما، الكراسي بتاعتك تسخين وتبريد ومساج",
    "ko": "파노라마 선루프에 열선/통풍/마사지 시트까지 다 들어갔습니다."
   },
   {
    "start": 53.4,
    "end": 59.3,
    "text": "وعندك كاميرا سيلفي عشان تسجل الذكريات",
    "ko": "추억을 남길 수 있는 실내 셀피 카메라까지 있습니다."
   }
  ],

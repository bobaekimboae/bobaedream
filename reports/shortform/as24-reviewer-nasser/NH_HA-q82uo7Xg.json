  "transcript": [
   {
    "start": 0.0,
    "end": 2.8,
    "text": "يا ناصر! مش هنام في الشغلانة دي ولا إيه؟",
    "ko": "나세르! 이 일터에서 잠도 못 자게 할 거야 뭐야?"
   },
   {
    "start": 2.8,
    "end": 4.1,
    "text": "أنا عايز عربية شبابية بتجري",
    "ko": "젊은 느낌 나고 화끈하게 달리는 차 한 대 줘."
   },
   {
    "start": 4.1,
    "end": 5.7,
    "text": "عندي صاروخين تحت هفرجهملك",
    "ko": "마침 아래층에 미사일 두 대가 대기 중이야, 보여줄게!"
   },
   {
    "start": 5.7,
    "end": 9.9,
    "text": "عندي M3 كومبيتيشن وموستنج دارك هورس",
    "ko": "M3 컴페티션하고 머스탱 다크 호스가 있어. 다크 호스 쎈가?"
   },
   {
    "start": 9.9,
    "end": 14.5,
    "text": "يا عم اسمها دارك، 5000 سي سي 8 سلندر بتطلع 500 حصان على دفع خلفي",
    "ko": "다크 호스는 5000cc 8기통 500마력 후륜구동이야."
   },
   {
    "start": 17.5,
    "end": 23.5,
    "text": "طب والـ M3؟ مش سامعك! 6 سلندر إنلاين بتطلع 500 حصان و650 نيوتن",
    "ko": "그럼 M3는? 안 들려 배기음 때문에! 직렬 6기통 500마력 650Nm 토크야."
   },
   {
    "start": 24.0,
    "end": 27.5,
    "text": "دفع رباعي وبتوصل من صفر لمية في 2.8",
    "ko": "4륜 구동에 제로백은 단 2.8초지."
   },
   {
    "start": 28.5,
    "end": 33.5,
    "text": "تقدر تقلبها خلفي، وعندك دريفت أنالايزر",
    "ko": "후륜으로 바꿀 수도 있고 드리프트 분석기도 들어있어."
   },
   {
    "start": 35.0,
    "end": 42.0,
    "text": "عجبتك من جوة عندك شاشة مزدوجة وفرامل يد للدريفت",
    "ko": "머스탱도 실내 더블 스크린에 드리프트용 핸드브레이크가 있지."
   },
   {
    "start": 44.0,
    "end": 48.0,
    "text": "مليانة كربون على السقف والتابلوه والكونسول",
    "ko": "M3는 루프, 대시보드, 콘솔 전체가 카본으로 덮여 있어."
   },
   {
    "start": 54.0,
    "end": 62.0,
    "text": "العربيات دي بكام؟ الموستنج أو الـ M من أول 5 مليون جنيه",
    "ko": "이 차들 얼마예요? 머스탱이나 M3 둘 다 500만 파운드부터 시작이야."
   }

  "transcript": [
   {
    "start": 0.0,
    "end": 2.5,
    "text": "أنا ناصر ولو ميزانيتك في حتة ال900,000 اتفرج",
    "ko": "저는 나사르입니다. 예산이 90만 파운드대라면 주목하세요."
   },
   {
    "start": 2.6,
    "end": 4.8,
    "text": "شانجان إيدو",
    "ko": "창안 이도입니다."
   },
   {
    "start": 4.9,
    "end": 6.8,
    "text": "عندك مراقب ضغط الكاوتشات وجنط سبور",
    "ko": "타이어 공기압 감지 시스템과 스포츠 휠이 들어가 있고,"
   },
   {
    "start": 6.9,
    "end": 9.1,
    "text": "المراية كهربا وتسخين عشان الشبورة وكيلس إنتري",
    "ko": "안개를 대비한 전동 열선 사이드미러와 키리스 엔트리,"
   },
   {
    "start": 9.2,
    "end": 11.7,
    "text": "وشنطة 500 لتر عشان الشنط والسفريات",
    "ko": "여행 짐을 싣기 충분한 500리터 트렁크 공간도 있습니다."
   },
   {
    "start": 11.8,
    "end": 15.5,
    "text": "أنوار العربية كلها ليد وعندك سنسورز وكاميرا خلفية بس مافيش من قدام",
    "ko": "전체 LED 램프에 센서와 후방 카메라가 있지만 전방 카메라는 없습니다."
   },
   {
    "start": 15.6,
    "end": 19.5,
    "text": "عندك دركسيون جلد، كروز كنترول، تحكم في الميديا وستارت إنجن",
    "ko": "가죽 스티어링 휠, 크루즈 컨트롤, 미디어 조작 버튼, 엔진 스타트 버튼이 있고요."
   },
   {
    "start": 19.6,
    "end": 23.2,
    "text": "وعندك شاشتين متصلين فيهم آبل كاربلاي وأندرويد أوتو وفتحة سقف عشان تدخلك نور",
    "ko": "애플 카플레이와 안드로이드 오토를 지원하는 듀얼 스크린과 채광용 선루프,"
   },
   {
    "start": 23.3,
    "end": 26.5,
    "text": "وكرسي السواق بس اللي كهربا والكنبة مساحتها كويسة إلى حد كبير",
    "ko": "운전석만 전동 시트가 적용되었고, 2열 뒷좌석 공간은 꽤 넉넉합니다."
   },
   {
    "start": 26.6,
    "end": 29.8,
    "text": "وعندك مخرج للتكييف وده أوبشن مهم في الفئة دي من العربيات",
    "ko": "뒷좌석 송풍구도 있는데, 이 급의 차급에서는 정말 중요한 옵션이죠."
   },
   {
    "start": 29.9,
    "end": 33.3,
    "text": "وبالنسبة للأمان عندك 4 إيرباج، ABS، EBD وESP",
    "ko": "안전 사양으로는 4개의 에어백, ABS, EBD, ESP가 들어갑니다."
   },
   {
    "start": 33.4,
    "end": 38.5,
    "text": "وبتخرج 109 حصان و152 نيوتن من موتور 1500 تنفس طبيعي عشان الاعتمادية",
    "ko": "내구성을 위해 1500cc 자연흡기 엔진으로 109마력, 152Nm 토크를 발휘하며,"
   },
   {
    "start": 38.6,
    "end": 42.0,
    "text": "متوصل بفتيس DCT سبع سرعات WET عشان الاعتمادية برضه",
    "ko": "신뢰성을 위해 7단 습식 DCT 변속기와 맞물려 있습니다."
   },
   {
    "start": 42.1,
    "end": 46.5,
    "text": "والضمان خمس سنين أو 150,000 كيلو عشان الاعتمادية، بهزر معاك عشان تطمن بس",
    "ko": "보증은 5년 또는 15만 km라 안심하실 수 있습니다."
   },
   {
    "start": 46.6,
    "end": 47.7,
    "text": "عشان تطمن بس",
    "ko": "안심하시라고 드리는 말씀입니다."
   }
  ],

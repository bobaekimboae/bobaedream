  "transcript": [
   {
    "start": 0.0,
    "end": 2.0,
    "text": "الريموت ده مش شغال ليه؟",
    "ko": "이 리모컨 왜 안 되지?"
   },
   {
    "start": 2.0,
    "end": 4.6,
    "text": "أخيراً جيت، عندي ليك صفقة نار",
    "ko": "드디어 왔네! 너한테 대박 거래 하나 줄게."
   },
   {
    "start": 4.6,
    "end": 7.7,
    "text": "إيه رأيك أديلك البوكستر وتديني الـ 911؟",
    "ko": "내가 박스터 줄 테니 911로 바꿀래?"
   },
   {
    "start": 7.7,
    "end": 12.6,
    "text": "بكام دي؟ بـ 12؟ طب علشان خاطري أنا؟ بـ 22",
    "ko": "이거 얼마야? 1200만? 그럼 날 봐서? 2200만."
   },
   {
    "start": 12.6,
    "end": 18.7,
    "text": "فرجني على الماكان.. ماكان وكيل؟",
    "ko": "마칸 좀 보여줘.. 공식 수입 마칸 맞아?"
   },
   {
    "start": 18.7,
    "end": 23.6,
    "text": "تعالى أفرجك الإيفوك.. تحفة بس حريمي أوي",
    "ko": "이보크 구경해봐.. 멋진데 너무 여성 취향이잖아."
   },
   {
    "start": 23.6,
    "end": 30.5,
    "text": "بنزين إيه ده؟ بنزين 95.. خنقوني!",
    "ko": "이건 무슨 기름 넣어? 95 옥탄.. 기름값에 숨 막히네!"
   },
   {
    "start": 30.5,
    "end": 34.6,
    "text": "طب ما تيجي أكهربك؟ EQA.. في حتة الـ 2 وحاجة بسيطة",
    "ko": "그럼 전기차 타볼래? EQA, 200만 언저리야."
   },
   {
    "start": 34.6,
    "end": 40.7,
    "text": "ماعندكش الفيراري الكهربا؟ شاومي 690 حصان.. يلا بينا!",
    "ko": "전기 페라리는 없어? 샤오미 690마력.. 바로 타보자!"
   },
   {
    "start": 40.7,
    "end": 48.8,
    "text": "الألماني ألماني برضه، BMW i5 بروتوكول أوروبي",
    "ko": "그래도 독일차가 최고지, BMW i5 유럽 규격 모델이야."
   },
   {
    "start": 48.8,
    "end": 54.8,
    "text": "تعالى أقولك حاجة في المايباخ",
    "ko": "마이바흐 안에서 얘기 좀 하자."
   },
   {
    "start": 54.8,
    "end": 61.5,
    "text": "كل العربيات دي هتلاقيها عند إسلام عبد العزيز",
    "ko": "이 모든 차들은 이슬람 압델아지즈 매장에 다 있습니다."
   }

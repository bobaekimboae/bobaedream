  "transcript": [
   {
    "start": 0.0,
    "end": 2.5,
    "text": "وسط ما العربيات عمالة تغلي والدنيا بتولع",
    "ko": "차 가격이 계속 치솟고 시장이 뜨거운 가운데"
   },
   {
    "start": 2.6,
    "end": 5.8,
    "text": "جبتلك عربية ما غليتش عائلية ومليانة اوبشن بايك اكس سيفن",
    "ko": "가격이 오르지 않은 패밀리카이자 옵션이 가득한 베이징 X7을 가져왔습니다"
   },
   {
    "start": 5.9,
    "end": 11.5,
    "text": "كراسيها تسخين علشان البرد وتبريد عشان الحر ومساج عشان الضهر حتى رجليك ليها مسند",
    "ko": "시트에는 추울 때 열선, 더울 때 통풍, 허리 마사지에 다리 받침대까지 있습니다"
   },
   {
    "start": 11.8,
    "end": 15.8,
    "text": "موتور 1500 تربو 180 حصان و 305 نيوتن عشان تنجز في الوقت",
    "ko": "1500cc 터보 엔진, 180마력 305Nm 토크로 시원하게 달립니다"
   },
   {
    "start": 15.9,
    "end": 22.8,
    "text": "ومن ورا الكنبة عائلية عندك بانوراما واصل لورا الكنبة مساحتها كويسة من غير نفق فتيس عشان ولادك يقعدوا مرتاحين",
    "ko": "뒷좌석은 패밀리형으로 파노라마 선루프가 뒤까지 이어지고, 센터터널이 없어 아이들이 편하게 앉을 수 있습니다"
   },
   {
    "start": 22.9,
    "end": 25.0,
    "text": "والفتيس دي سي تي عشان الاداء وويت عشان يعيش",
    "ko": "변속기는 반응성이 좋은 웻 듀얼클러치(DCT)가 들어갔습니다"
   },
   {
    "start": 25.1,
    "end": 33.2,
    "text": "وعندك ديجيتال ديسبلاي متصلة بتاتش سكرين فيها ابل كاربلاي وايزي كونكشن شاشة للتكييف والكراسي وكاميرات 360 شاحن وايرلس عشان تحس بالتطور",
    "ko": "디지털 계기판과 터치스크린이 연결되어 카플레이와 무선충전, 360도 카메라, 공조 제어 화면까지 갖췄습니다"
   },
   {
    "start": 33.3,
    "end": 37.7,
    "text": "وفيها ستة ايرباج كروز كنترول وفل اداس عشان سلامتكم",
    "ko": "안전을 위해 6개 에어백, 크루즈 컨트롤, 풀 ADAS 주행보조 시스템이 탑재되었습니다"
   },
   {
    "start": 37.8,
    "end": 44.8,
    "text": "لو اشتريت العربية دي كاش هتاخد خصم 150 الف عن الرسمي ولو خدتها قسط ودفعت 50% هتقسط على سنتين من غير فوائد",
    "ko": "현금 구매 시 정가 대비 15만 할인, 50% 선납 시 2년 무이자 할부가 가능합니다"
   },
   {
    "start": 44.9,
    "end": 49.7,
    "text": "ولو خدتها قسط على خمس سنين بمقدم 30% هتاخد خصم 300 الف جنيه عن الرسمي",
    "ko": "선납 30%로 5년 할부 진행 시 무려 30만 파운드 할인이 들어갑니다"
   },
   {
    "start": 49.8,
    "end": 55.4,
    "text": "وفي كود خصم ناصر عشرة والعربية دي بكل الألوان موجودة في كل فروع الليثي",
    "ko": "할인코드 NASSER10도 있으며 모든 색상이 엘리시(Ellithy) 전 지점에 입고되어 있습니다",
    "sure": true
   }

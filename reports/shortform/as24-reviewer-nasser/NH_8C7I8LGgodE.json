  "transcript": [
   {
    "start": 0.0,
    "end": 3.9,
    "text": "انا ناصر ولو عايز عربية تحت المليون جنيه جبتلك مقارنة التلات خمسات",
    "ko": "저는 나사르입니다. 100만 파운드 이하의 차를 원하신다면 '3개의 5' 비교를 준비했습니다."
   },
   {
    "start": 4.0,
    "end": 5.4,
    "text": "اقدمهم في السوق الـ MG 5",
    "ko": "시장에서 가장 오래된 MG 5,"
   },
   {
    "start": 5.5,
    "end": 7.8,
    "text": "اكتر واحدة شبابي ورياضية كايي E5",
    "ko": "가장 젊고 스포티한 카이이 E5,"
   },
   {
    "start": 7.9,
    "end": 9.9,
    "text": "والمنافس الشرس البايك U5",
    "ko": "그리고 강력한 라이벌 베이징 U5 플러스입니다."
   },
   {
    "start": 10.0,
    "end": 12.5,
    "text": "الـ MG من جوة عندك فتحة سقف والكراسي بتاعتك جلد",
    "ko": "MG 실내에는 썬루프와 가죽 시트가 적용되어 있습니다."
   },
   {
    "start": 12.6,
    "end": 14.7,
    "text": "تاتش سكرين فيها ابل كاربلاي واندرويد اوتو",
    "ko": "터치스크린은 애플 카플레이와 안드로이드 오토를 지원합니다."
   },
   {
    "start": 14.8,
    "end": 16.5,
    "text": "الدريكسيون مالتي فانكشن وعدادات انالوج",
    "ko": "멀티펑션 스티어링 휠과 아날로그 계기판이 들어갑니다."
   },
   {
    "start": 16.6,
    "end": 19.8,
    "text": "في البايك العدادات ديجيتال والشاشة بتاعتك متصلة",
    "ko": "BAIC의 경우 디지털 계기판과 일체형 와이드 디스플레이가 장착되었습니다."
   },
   {
    "start": 19.9,
    "end": 21.8,
    "text": "والكراسي بتاعتك شكلها احلى عندك سوفت تاتش اكتر",
    "ko": "시트 디자인이 더 고급스럽고 부드러운 소재 마감이 많습니다."
   },
   {
    "start": 21.9,
    "end": 24.0,
    "text": "بس كرسي الكايي رياضي اكتر",
    "ko": "하지만 Kaiyi 시트가 훨씬 스포티합니다."
   },
   {
    "start": 24.1,
    "end": 28.9,
    "text": "ونفس الكلام بيمشي على الكونسول والزيادة عندك شاحن وايرلس واستيتش احمر على الدريكسيون الجلد",
    "ko": "콘솔도 마찬가지이며 무선 충전기와 가죽 핸들의 레드 스티치가 추가됩니다."
   },
   {
    "start": 29.0,
    "end": 33.6,
    "text": "موتور البايك 1500 تنفس طبيعي 111 حصان و142 نيوتن",
    "ko": "BAIC의 엔진은 1.5 자연흡기 111마력 142토크입니다."
   },
   {
    "start": 33.7,
    "end": 39.8,
    "text": "انما الكايي 1500 تربو 156 حصان و230 نيوتن فعامل القوة لصالح الـ E5",
    "ko": "반면 Kaiyi는 1.5 터보 156마력 230토크로 힘은 E5의 압승입니다."
   },
   {
    "start": 39.9,
    "end": 44.2,
    "text": "الـ MG اقوى 1500 تنفس طبيعي 120 حصان و150 نيوتن",
    "ko": "MG는 1.5 자연흡기 중 더 강력한 120마력 150토크를 냅니다."
   },
   {
    "start": 44.3,
    "end": 46.8,
    "text": "نبدا بالـ MG هي اصغر كنبة ومش واصلها التكييف ورا",
    "ko": "MG부터 보면 뒷좌석이 가장 좁고 후석 에어컨 송풍구가 없습니다."
   },
   {
    "start": 46.9,
    "end": 50.0,
    "text": "والبايك اوسعهم كمساحات للرجلين وفيها اصغر نفق فتيس",
    "ko": "BAIC는 다리 공간이 가장 넓고 센터 터널이 가장 낮습니다."
   },
   {
    "start": 50.1,
    "end": 54.7,
    "text": "كنبة الكايي هي الاريح والوحيدة بمسند للايد وبرضه الوحيدة اللي واصلها فتحات تكييف",
    "ko": "Kaiyi의 뒷좌석이 가장 안락하며 유일하게 팔걸이와 후석 송풍구를 갖췄습니다."
   },
   {
    "start": 54.8,
    "end": 56.8,
    "text": "البايك بتنزل بجنط تو تون 16",
    "ko": "BAIC는 16인치 투톤 휠이 장착됩니다."
   },
   {
    "start": 56.9,
    "end": 59.0,
    "text": "بتاع الـ MG احلى بس 16 برضه",
    "ko": "MG 휠이 더 예쁘지만 마찬가지로 16인치입니다."
   },
   {
    "start": 59.1,
    "end": 62.8,
    "text": "بس الكايي 17 وهي الوحيدة بعفشة مالتي لينك فهتلاقيها اثبت عالسرعات",
    "ko": "하지만 Kaiyi는 17인치 휠에 유일한 멀티링크 서스펜션으로 고속 안정감이 뛰어납니다."
   },
   {
    "start": 62.9,
    "end": 65.5,
    "text": "بس البايك هي اصغر شنطة 430 لتر",
    "ko": "트렁크는 BAIC가 430리터로 가장 작고,"
   },
   {
    "start": 65.6,
    "end": 68.2,
    "text": "الكايي اكبر 455 لتر",
    "ko": "Kaiyi는 455리터로 더 큽니다."
   },
   {
    "start": 68.3,
    "end": 70.3,
    "text": "واكبرهم الـ MG 5 بـ 512 لتر",
    "ko": "가장 큰 것은 MG 5의 512리터입니다."
   },
   {
    "start": 70.4,
    "end": 74.5,
    "text": "والتلاتة عليهم عرض لما بتدفع 50% بتقسط على 18 شهر من غير فوايد",
    "ko": "세 모델 모두 50% 납부 시 18개월 무이자 할부 프로모션이 적용됩니다."
   },
   {
    "start": 74.6,
    "end": 79.5,
    "text": "اي عربية انت عايزها هتلاقيها في AMG الغلبان وده اجدد فرع في اجورا مول الشيخ زايد",
    "ko": "원하시는 모든 차는 AMG 엘갈반에서 만나보실 수 있으며, 여기는 아고라 몰 셰이크 자이드 신규 지점입니다."
   }
  ],

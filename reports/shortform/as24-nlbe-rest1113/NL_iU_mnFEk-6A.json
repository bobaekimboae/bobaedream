  "transcript": [
   {
    "start": 0.0,
    "end": 3.3,
    "text": "Kan jij raden hoeveel pk deze Volkswagen Golf eHybrid heeft?",
    "ko": "이 폭스바겐 골프 e하이브리드가 몇 마력인지 맞출 수 있나요?"
   },
   {
    "start": 3.4,
    "end": 5.5,
    "text": "Die je vindt op Autoscout24.nl.",
    "ko": "AutoScout24.nl에서 확인하실 수 있습니다."
   },
   {
    "start": 5.6,
    "end": 7.8,
    "text": "Ik vertel je 5 dingen over deze auto.",
    "ko": "이 차의 5가지 특징을 알려드릴게요."
   },
   {
    "start": 7.9,
    "end": 11.4,
    "text": "Het is dus een hybride, elektrisch gecombineerd met benzine.",
    "ko": "하이브리드 모델로, 전기와 가솔린이 결합되어 있습니다."
   },
   {
    "start": 11.5,
    "end": 15.0,
    "text": "Hij heeft ErgoActive massagestoelen, afgewerkt met Alcantara.",
    "ko": "알칸타라로 마감된 에르고액티브 마사지 시트가 장착되어 있습니다."
   },
   {
    "start": 15.1,
    "end": 19.4,
    "text": "Hij heeft adaptive cruise control, stuurverwarming maar ook stoelverwarming en Apple CarPlay.",
    "ko": "어댑티브 크루즈 컨트롤, 열선 핸들, 열선 시트 및 애플 카플레이가 포함되어 있습니다."
   },
   {
    "start": 19.5,
    "end": 20.8,
    "text": "Hij heeft 17-inch velgen.",
    "ko": "17인치 휠이 장착되어 있습니다."
   },
   {
    "start": 20.9,
    "end": 22.9,
    "text": "En hij kost €19.950.",
    "ko": "그리고 가격은 19,950유로입니다."
   },
   {
    "start": 23.0,
    "end": 28.4,
    "text": "Weet jij hoeveel pk deze auto heeft? Laat het weten in een reactie en vergeet ons niet te volgen.",
    "ko": "이 차가 몇 마력인지 아시나요? 댓글로 남겨주시고 팔로우도 잊지 마세요."
   }
  ],

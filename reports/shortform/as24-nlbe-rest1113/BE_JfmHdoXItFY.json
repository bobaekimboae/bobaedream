  "transcript": [
   {
    "start": 0.0,
    "end": 2.5,
    "text": "5 leuke details van de nieuwe Kia EV5.",
    "ko": "신형 기아 EV5의 매력적인 5가지 디테일."
   },
   {
    "start": 2.5,
    "end": 6.8,
    "text": "Een stoer en hoekig design aan de voorkant, maar ook aan de achterkant.",
    "ko": "전면부뿐만 아니라 후면부까지 강인하고 각진 디자인."
   },
   {
    "start": 6.8,
    "end": 9.0,
    "text": "Hij heeft een actieradius tot 500 km.",
    "ko": "주행거리는 최대 500km에 달합니다."
   },
   {
    "start": 9.0,
    "end": 11.2,
    "text": "Stoelverwarming voor en achter.",
    "ko": "앞좌석과 뒷좌석 시트 열선 기능."
   },
   {
    "start": 11.2,
    "end": 13.3,
    "text": "Hij heeft een vlakke laadvloer,",
    "ko": "평평한 트렁크 적재 바닥과,"
   },
   {
    "start": 13.3,
    "end": 15.8,
    "text": "en een skiluik voor het vervoeren van lange spullen.",
    "ko": "긴 짐을 싣기 위한 스키 스루 공간까지."
   },
   {
    "start": 15.8,
    "end": 19.1,
    "text": "En als laatste, een handig opbergvakje wat gekoeld is.",
    "ko": "그리고 마지막으로 냉장 기능이 있는 유용한 수납함."
   },
   {
    "start": 19.1,
    "end": 25.4,
    "text": "Je vindt de Kia EV5 in de showroom van Kia Vermant en binnenkort op AutoScout24.",
    "ko": "기아 EV5는 기아 Vermant 쇼룸에서, 곧 AutoScout24에서도 만나보실 수 있습니다."
   }
  ],

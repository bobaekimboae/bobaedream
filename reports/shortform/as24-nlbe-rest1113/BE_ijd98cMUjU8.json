  "transcript": [
   {
    "start": 0.0,
    "end": 2.0,
    "text": "Dit is de Micro Microlino.",
    "ko": "이것은 마이크로 마이크롤리노입니다."
   },
   {
    "start": 2.0,
    "end": 4.1,
    "text": "Een kleine elektrische stadsauto.",
    "ko": "작은 도심형 전기차죠."
   },
   {
    "start": 4.1,
    "end": 5.9,
    "text": "Maar wat maakt deze nou zo uniek?",
    "ko": "하지만 왜 이 차가 이렇게 특별할까요?"
   },
   {
    "start": 5.9,
    "end": 8.0,
    "text": "Wil je hem opendoen, duw je op dit knopje.",
    "ko": "차를 열고 싶다면 이 버튼을 누르면 됩니다."
   },
   {
    "start": 8.0,
    "end": 10.3,
    "text": "Je hebt plek voor twee personen,",
    "ko": "2명을 위한 공간이 마련되어 있고,"
   },
   {
    "start": 10.3,
    "end": 11.8,
    "text": "de bestuurder en een passagier.",
    "ko": "운전자와 동승자가 탈 수 있죠."
   },
   {
    "start": 11.8,
    "end": 14.2,
    "text": "Je hebt geen versnellingspook maar je hebt knoppen.",
    "ko": "기어봉은 없고 대신 버튼들이 있습니다."
   },
   {
    "start": 14.2,
    "end": 16.0,
    "text": "Je hebt dan Reverse, Neutral en Drive.",
    "ko": "후진(R), 중립(N), 주행(D) 버튼이 있죠."
   },
   {
    "start": 16.0,
    "end": 17.8,
    "text": "Hier vind je de toeter.",
    "ko": "여기엔 경적이 있습니다."
   },
   {
    "start": 17.8,
    "end": 21.4,
    "text": "En de koffer opendoen doe je via dit touchscreen, op dit knopje.",
    "ko": "트렁크를 여는 건 이 터치스크린의 버튼을 통해서 합니다."
   },
   {
    "start": 21.4,
    "end": 26.6,
    "text": "Het is een tweepersoonsauto waardoor je dus extra veel kofferruimte hebt.",
    "ko": "2인승 차량이라 트렁크 공간이 아주 넉넉합니다."
   },
   {
    "start": 26.6,
    "end": 28.5,
    "text": "En de handrem, die vind je hier.",
    "ko": "핸드브레이크는 여기에 있습니다."
   },
   {
    "start": 28.5,
    "end": 30.7,
    "text": "Een plek voor je beker en om je telefoon op te laden.",
    "ko": "컵 홀더와 휴대폰을 충전할 수 있는 공간도 있죠."
   },
   {
    "start": 30.7,
    "end": 32.1,
    "text": "Een kleine digital dash,",
    "ko": "작은 디지털 계기판과,"
   },
   {
    "start": 32.1,
    "end": 33.0,
    "text": "telefoonhouder,",
    "ko": "휴대폰 거치대,"
   },
   {
    "start": 33.0,
    "end": 36.4,
    "text": "en een knopje voor de deur open te doen, die bevindt zich hier.",
    "ko": "그리고 문을 열기 위한 버튼은 여기에 있습니다."
   },
   {
    "start": 36.4,
    "end": 38.0,
    "text": "En hij heeft een panoramadak.",
    "ko": "파노라마 루프도 갖추고 있어요."
   },
   {
    "start": 38.0,
    "end": 40.0,
    "text": "Verder heeft hij 3.900 km gereden,",
    "ko": "주행거리는 3,900km이고,"
   },
   {
    "start": 40.0,
    "end": 42.7,
    "text": "komt uit 2024.",
    "ko": "2024년식 모델입니다."
   },
   {
    "start": 42.7,
    "end": 47.6,
    "text": "Je vindt deze Micro Microlino op AutoScout24.be of bij Belgicars.",
    "ko": "이 마이크로 마이크롤리노는 AutoScout24.be나 Belgicars에서 만나보실 수 있습니다."
   }

  "transcript": [
   {
    "start": 0.0,
    "end": 2.6,
    "text": "Deze auto wordt vaak gekozen als eerste auto.",
    "ko": "이 차는 첫 차로 자주 선택되는 모델입니다."
   },
   {
    "start": 2.6,
    "end": 3.6,
    "text": "Dit is een Citroën C1.",
    "ko": "바로 시트로엥 C1입니다."
   },
   {
    "start": 3.6,
    "end": 6.8,
    "text": "Hij is vergelijkbaar met de Toyota Aygo en de Peugeot 108.",
    "ko": "도요타 아이고나 푸조 108과 비교되는 차량이죠."
   },
   {
    "start": 6.8,
    "end": 11.8,
    "text": "Hij heeft slechts 16.000 km gelopen en hij kost minder dan €10.000.",
    "ko": "주행거리는 겨우 16,000km에 가격은 1만 유로 미만입니다."
   },
   {
    "start": 11.8,
    "end": 14.7,
    "text": "En hij heeft airco, een multifunctioneel stuur en bluetooth.",
    "ko": "에어컨, 다기능 스티어링 휠, 블루투스까지 갖췄습니다."
   },
   {
    "start": 14.7,
    "end": 18.7,
    "text": "Hij is klein, licht en super wendbaar en daarom ook laag in verbruik.",
    "ko": "작고 가벼워 조작이 민첩하며 연비 또한 훌륭합니다."
   },
   {
    "start": 18.7,

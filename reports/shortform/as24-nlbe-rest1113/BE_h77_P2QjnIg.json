  "transcript": [
   {
    "start": 0.0,
    "end": 2.0,
    "text": "Naast mij staat de Volkswagen T-Roc.",
    "ko": "제 옆에는 폭스바겐 티록이 있습니다."
   },
   {
    "start": 2.0,
    "end": 6.6,
    "text": "Hij komt uit 2025, heeft 116 PK en is een benzine.",
    "ko": "2025년식 모델이며 116마력의 가솔린 차량입니다."
   },
   {
    "start": 6.6,
    "end": 7.5,
    "text": "Hij is handgeschakeld.",
    "ko": "수동 변속기입니다."
   },
   {
    "start": 7.5,
    "end": 10.0,
    "text": "Hij heeft opties zoals onder andere zetelverwarming,",
    "ko": "열선 시트와 같은 다양한 옵션이 들어가 있고,"
   },
   {
    "start": 10.0,
    "end": 11.2,
    "text": "stuurverwarming,",
    "ko": "스티어링 휠 열선,"
   },
   {
    "start": 11.2,
    "end": 12.3,
    "text": "Adaptive cruise control,",
    "ko": "어댑티브 크루즈 컨트롤,"
   },
   {
    "start": 12.3,
    "end": 13.0,
    "text": "lane assist,",
    "ko": "차선 유지 보조,"
   },
   {
    "start": 13.0,
    "end": 15.6,
    "text": "achteruitrijcamera en parkeersensoren,",
    "ko": "후방 카메라와 주차 센서,"
   },
   {
    "start": 15.6,
    "end": 18.6,
    "text": "en hij is uitgevoerd met Apple CarPlay en Android Auto.",
    "ko": "그리고 애플 카플레이와 안드로이드 오토가 지원됩니다."
   },
   {
    "start": 18.6,
    "end": 20.8,
    "text": "En hij heeft getinte achterruiten.",
    "ko": "틴팅된 뒷유리도 적용되어 있습니다."
   },
   {
    "start": 20.8,
    "end": 24.3,
    "text": "Deze auto is volledig nieuw en je kunt hem vinden in de showroom van",
    "ko": "이 차량은 완전 신차이며 전시장에서 만나보실 수 있습니다."
   },
   {
    "start": 24.3,

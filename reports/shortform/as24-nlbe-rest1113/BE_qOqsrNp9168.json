  "transcript": [
   {
    "start": 0.0,
    "end": 3.2,
    "text": "Dit zijn 5 dingen die jij moet weten over de Renault 5 E-Tech.",
    "ko": "르노 5 E-Tech에 대해 알아야 할 5가지 사실입니다."
   },
   {
    "start": 3.2,
    "end": 6.0,
    "text": "Dit nieuwe model zit vol naar verwijzingen van de retromodellen.",
    "ko": "이 신형 모델은 과거 레트로 모델들의 디테일로 가득 차 있습니다."
   },
   {
    "start": 6.0,
    "end": 7.0,
    "text": "Het dashboard,",
    "ko": "대시보드,"
   },
   {
    "start": 7.0,
    "end": 7.8,
    "text": "de stoelen,",
    "ko": "시트,"
   },
   {
    "start": 7.8,
    "end": 10.4,
    "text": "batterij indicator in plaats van de luchtinlaat,",
    "ko": "에어 인테이크 자리의 배터리 잔량 표시계,"
   },
   {
    "start": 10.4,
    "end": 11.6,
    "text": "vierkante lampjes,",
    "ko": "사각 램프,"
   },
   {
    "start": 11.6,
    "end": 13.0,
    "text": "en dit flapje.",
    "ko": "그리고 이 헤리티지 라벨까지요."
   },
   {
    "start": 13.0,
    "end": 17.0,
    "text": "Hij is volledig elektrisch en heeft een maximale actieradius van 410 km.",
    "ko": "순수 전기차이며 최대 주행거리는 410km입니다."
   },
   {
    "start": 17.0,
    "end": 21.7,
    "text": "Hij kan bidirectioneel laden, dat houdt in dat hij ook gebruikt kan worden als thuisbatterij.",
    "ko": "양방향 충전이 가능해 가정용 ESS 배터리로도 활용할 수 있습니다."
   },
   {
    "start": 21.7,
    "end": 24.0,
    "text": "Hij heeft verschillende rijstanden.",
    "ko": "다양한 주행 모드를 지원하며,"
   },
   {
    "start": 24.0,
    "end": 25.5,
    "text": "Hij is full option uitgevoerd,",
    "ko": "풀옵션 구성으로,"
   },
   {
    "start": 25.5,
    "end": 28.5,
    "text": "van adaptive cruise control tot stoel- en stuurverwarming,",
    "ko": "어댑티브 크루즈 컨트롤부터 시트·스티어링 열선,"
   },
   {
    "start": 28.5,
    "end": 30.6,
    "text": "tot volledige rijondersteuning.",
    "ko": "완벽한 첨단 주행 보조 기능까지 갖췄습니다."
   },
   {
    "start": 30.6,
    "end": 35.0,
    "text": "Je vindt hem in de showroom van VD Motors en op Autoscout24.be",
    "ko": "VD Motors 전시장과 AutoScout24.be에서 만나보실 수 있습니다."
   }
  ],

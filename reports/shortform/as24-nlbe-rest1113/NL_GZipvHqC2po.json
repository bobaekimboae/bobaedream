  "transcript": [
   {
    "start": 0.0,
    "end": 2.7,
    "text": "Ik vertel je meer over deze Volkswagen Golf in 30 seconden,",
    "ko": "30초 만에 이 폭스바겐 골프에 대해 더 알려드릴게요,"
   },
   {
    "start": 2.7,
    "end": 5.7,
    "text": "en de prijs vertel ik je op het eind en die gaat je verbazen.",
    "ko": "가격은 마지막에 알려드릴 텐데, 깜짝 놀라실 거예요."
   },
   {
    "start": 5.7,
    "end": 9.4,
    "text": "Hij heeft ergoActive massagestoelen afgewerkt met Alcantara,",
    "ko": "알칸타라로 마감된 에르고액티브 마사지 시트가 있고,"
   },
   {
    "start": 9.4,
    "end": 10.9,
    "text": "en het is een schakelauto.",
    "ko": "수동 변속기 모델입니다."
   },
   {
    "start": 10.9,
    "end": 12.6,
    "text": "Hij is afkomstig van de eerste eigenaar,",
    "ko": "1인 신조 차량이며,"
   },
   {
    "start": 12.6,
    "end": 15.6,
    "text": "hij heeft een multifunctioneel stuur met adaptive cruise control,",
    "ko": "어댑티브 크루즈 컨트롤이 탑재된 다기능 스티어링 휠,"
   },
   {
    "start": 15.6,
    "end": 17.8,
    "text": "stuurverwarming, maar ook stoelverwarming,",
    "ko": "스티어링 휠 열선뿐만 아니라 시트 열선도 있고,"
   },
   {
    "start": 17.8,
    "end": 19.3,
    "text": "en hij heeft Apple CarPlay.",
    "ko": "애플 카플레이도 지원합니다."
   },
   {
    "start": 19.3,
    "end": 20.6,
    "text": "Hij heeft 110 pk,",
    "ko": "110마력이며,"
   },
   {

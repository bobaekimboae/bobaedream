  "transcript": [
   {
    "start": 0.0,
    "end": 2.5,
    "text": "Op zoek naar een auto met meer dan 400 pk?",
    "ko": "400마력이 넘는 차를 찾고 계신가요?"
   },
   {
    "start": 2.5,
    "end": 4.1,
    "text": "Voor welke zou jij kiezen?",
    "ko": "당신이라면 어떤 차를 선택하시겠습니까?"
   },
   {
    "start": 4.1,
    "end": 8.7,
    "text": "Vind jij 400 pk genoeg, kies dan de Audi TT RS.",
    "ko": "400마력으로 충분하다면 아우디 TT RS를 선택하세요."
   },
   {
    "start": 8.7,
    "end": 10.8,
    "text": "Hij is vierwiel aangedreven.",
    "ko": "4륜 구동 모델입니다."
   },
   {
    "start": 14.5,
    "end": 16.5,
    "text": "Hij komt uit 2022,",
    "ko": "2022년식이고,"
   },
   {
    "start": 16.5,
    "end": 18.5,
    "text": "heeft 72.000 km gereden,",
    "ko": "72,000 km를 주행했으며,"
   },
   {
    "start": 18.5,
    "end": 21.0,
    "text": "en hij kost €48.500.",
    "ko": "가격은 48,500유로입니다."
   },
   {
    "start": 21.0,
    "end": 24.8,
    "text": "Of ga jij voor de BMW M3 met 431 pk?",
    "ko": "아니면 431마력의 BMW M3를 선택하시겠습니까?"
   },
   {
    "start": 29.5,
    "end": 31.0,
    "text": "Hij komt uit 2017,",
    "ko": "2017년식이고,"
   },
   {
    "start": 31.0,
    "end": 32.5,
    "text": "41.500 km gereden,",
    "ko": "41,500 km 주행했으며,"
   },
   {
    "start": 32.5,
    "end": 35.8,
    "text": "en hij kost €51.500.",
    "ko": "가격은 51,500유로입니다."
   },
   {
    "start": 35.8,
    "end": 40.5,
    "text": "Hij staat in de showroom van SB Cars en op AutoScout24.nl.",
    "ko": "SB Cars 쇼룸 및 AutoScout24 웹사이트에서 만나보실 수 있습니다."

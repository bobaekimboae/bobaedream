  "transcript": [
   {
    "start": 0.0,
    "end": 2.8,
    "text": "Deze auto kostte nieuw meer dan een gemiddeld huis.",
    "ko": "이 차는 신차 가격이 평균적인 집 한 채보다 비쌌습니다."
   },
   {
    "start": 2.8,
    "end": 5.0,
    "text": "Dit is de McLaren 570S.",
    "ko": "이 차는 맥라렌 570S입니다."
   },
   {
    "start": 5.0,
    "end": 8.8,
    "text": "Een 3.8 liter twin-turbo V8 met 570 pk.",
    "ko": "570마력을 내는 3.8리터 트윈터보 V8 엔진이죠."
   },
   {
    "start": 8.8,
    "end": 13.5,
    "text": "Van 0 naar 100 in 3 seconden.",
    "ko": "0에서 100km/h까지 단 3초 만에 주파합니다."
   },
   {
    "start": 13.5,
    "end": 16.8,
    "text": "En hij gaat gewoon door tot 328 km/u.",
    "ko": "그리고 최고 속도는 무려 328km/h에 달하죠."
   },
   {
    "start": 16.8,
    "end": 19.0,
    "text": "Nou, zo snel ben ik nog nooit gegaan.",
    "ko": "글쎄요, 저도 그렇게 빨리 달려본 적은 없네요."
   },
   {
    "start": 19.0,
    "end": 23.0,
    "text": "En wat veel mensen niet weten, is dat deze McLaren maar 1.415 kg weegt.",
    "ko": "그리고 많은 분들이 모르는 사실인데, 이 맥라렌의 무게는 고작 1,415kg입니다."
   },
   {
    "start": 23.0,
    "end": 25.5,
    "text": "Daardoor voelt hij absurd snel aan.",
    "ko": "그래서 체감상 말도 안 되게 빠르게 느껴집니다."
   },
   {
    "start": 25.5,
    "end": 30.0,
    "text": "Ben je benieuwd naar de prijs, het bouwjaar en de kilometerstand van deze auto? Lees dan even de omschrijving.",
    "ko": "이 차의 가격, 연식, 주행거리가 궁금하신가요? 설명란을 확인해보세요."
   },
   {
    "start": 30.0,
    "end": 36.0,
    "text": "En je vindt hem in de showroom van Autobedrijf Jos Priem en natuurlijk op autoscout24.nl.",
    "ko": "오토베드라이프 요스 프림 전시장과 물론 autoscout24.nl에서 만나보실 수 있습니다."
   }
  ],

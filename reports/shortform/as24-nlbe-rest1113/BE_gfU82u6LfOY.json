  "transcript": [
   {
    "start": 0.0,
    "end": 1.2,
    "text": "Auto verkopen?",
    "ko": "차를 판매하시나요?"
   },
   {
    "start": 1.2,
    "end": 3.0,
    "text": "Wat denk je dat jouw auto waard is?",
    "ko": "내 차가 얼마의 가치가 있다고 생각하시나요?"
   },
   {
    "start": 3.0,
    "end": 7.3,
    "text": "Met de waardebepaling van AutoScout24 krijg je een correcte prijsindicatie van jouw voertuig.",
    "ko": "AutoScout24 시세 조회를 통하면 차량의 정확한 예상 가격을 확인할 수 있습니다."
   },
   {
    "start": 7.3,
    "end": 10.9,
    "text": "Wat is een correcte prijs voor deze Volkswagen Golf GTE?",
    "ko": "이 폭스바겐 골프 GTE의 적정 가격은 얼마일까요?"
   },
   {
    "start": 10.9,
    "end": 12.8,
    "text": "Open de AutoScout app.",
    "ko": "AutoScout 앱을 켭니다."
   },
   {
    "start": 12.8,
    "end": 15.0,
    "text": "Dan ga je naar het kopje verkopen.",
    "ko": "그리고 판매 탭으로 이동합니다."
   },
   {
    "start": 15.0,
    "end": 17.0,
    "text": "En dan heb je hier prijsindicatie.",
    "ko": "그럼 여기에 가격 산정 메뉴가 있습니다."
   },
   {
    "start": 17.0,
    "end": 19.0,
    "text": "Dan typ je hier het merk.",
    "ko": "여기 제조사를 입력하고,"
   },
   {
    "start": 19.0,
    "end": 21.0,
    "text": "Het bouwjaar, maand, en dan...",
    "ko": "연식과 등록 월, 그리고..."
   },
   {
    "start": 21.0,
    "end": 22.5,
    "text": "de kilometerstand.",
    "ko": "주행거리입니다."
   },
   {
    "start": 22.5,
    "end": 24.0,
    "text": "En daarna vul je je mailadres in.",
    "ko": "그런 다음 이메일 주소를 입력합니다."
   },
   {
    "start": 24.0,
    "end": 26.5,
    "text": "En dan krijg je een schatting van AutoScout24.",
    "ko": "그러면 AutoScout24의 예상 견적을 받게 됩니다."
   },
   {
    "start": 26.5,
    "end": 29.0,
    "text": "Dus voor deze Volkswagen Golf 1.4 eHybrid...",
    "ko": "따라서 이 폭스바겐 골프 1.4 eHybrid의 경우..."
   },
   {
    "start": 29.0,
    "end": 32.5,
    "text": "zit je op een minimale prijs van €20.890...",
    "ko": "최저 가격은 20,890 유로부터,"
   },
   {
    "start": 32.5,
    "end": 35.8,
    "text": "en een maximale prijs van €25.375.",
    "ko": "최고 가격은 25,375 유로까지 나옵니다."
   },
   {
    "start": 35.8,
    "end": 39.6,
    "text": "En zo gemakkelijk is het via de AutoScout24 app.",

  "transcript": [
   {
    "start": 0.0,
    "end": 2.7,
    "text": "Raad de prijs van deze Volkswagen Golf GTI.",
    "ko": "이 폭스바겐 골프 GTI의 가격을 맞혀보세요."
   },
   {
    "start": 2.7,
    "end": 4.1,
    "text": "Hij komt uit 2019,",
    "ko": "2019년식이며,"
   },
   {
    "start": 4.1,
    "end": 6.4,
    "text": "heeft 65.000 km gereden,",
    "ko": "주행거리는 65,000 km입니다."
   },
   {
    "start": 6.4,
    "end": 8.3,
    "text": "en heeft 245 pk.",
    "ko": "그리고 245마력입니다."
   },
   {
    "start": 8.3,
    "end": 11.5,
    "text": "Opties zoals onder andere Adaptive Cruise Control, Apple CarPlay,",
    "ko": "어댑티브 크루즈 컨트롤, 애플 카플레이 등의 옵션과,"
   },
   {
    "start": 11.5,
    "end": 14.4,
    "text": "en zo de auto een multifunctioneel stuur met schakelflippers.",
    "ko": "패들시프트가 장착된 다기능 스티어링 휠이 적용되었습니다."
   },
   {
    "start": 14.4,
    "end": 16.5,
    "text": "Het is een DSG automaat,",
    "ko": "DSG 자동변속기,"
   },
   {
    "start": 16.5,
    "end": 17.6,
    "text": "dodehoekdetectie,",
    "ko": "사각지대 감지 기능,"
   },
   {
    "start": 17.6,
    "end": 18.7,
    "text": "20 inch velgen,",
    "ko": "20인치 휠,"
   },
   {
    "start": 18.7,
    "end": 19.9,
    "text": "getinte ramen,",
    "ko": "틴팅 유리,"
   },
   {
    "start": 19.9,
    "end": 22.8,
    "text": "en een kofferruimte voor vier volle boodschappentassen.",
    "ko": "쇼핑백 4개가 넉넉히 들어가는 트렁크 공간도 갖췄습니다."
   },
   {

 "sentences": [
  {
   "a": 0,
   "b": 2.3,
   "at": 0.1,
   "text": "아이고야 카니발 나왔데이"
  },
  {
   "a": 2.49,
   "b": 5.79,
   "at": 2.6,
   "text": "2024년 8월에 등록한 그래비티 아이가"
  },
  {
   "a": 5.96,
   "b": 8.71,
   "at": 5.95,
   "text": "눈은 LED라가 번쩍번쩍하네"
  },
  {
   "a": 8.85,
   "b": 11.16,
   "at": 9.3,
   "text": "신발은 시커먼 휠 신었고"
  },
  {
   "a": 11.5,
   "b": 14.6,
   "at": 11.9,
   "text": "트렁크는 지 혼자 열린다 손 안 대도 된다카이"
  },
  {
   "a": 14.85,
   "b": 18.33,
   "at": 16.3,
   "text": "아홉 명 탄다 아이가 시댁 식구 다 태아도 된데이"
  },
  {
   "a": 18.9,
   "b": 21.68,
   "at": 20.6,
   "text": "옆문 열모 2열은 의자가 따로따로데이"
  },
  {
   "a": 22.09,
   "b": 25.68,
   "at": 24.2,
   "text": "시트는 밝은 베이지라가 과자 흘리모 다 보인다"
  },
  {
   "a": 26.16,
   "b": 29.91,
   "at": 27.8,
   "text": "기어는 동글뱅이 돌리는 기고 컵 꽂는 데도 두 군데다"
  },
  {
   "a": 30.4,
   "b": 33.59,
   "at": 35.2,
   "text": "계기판에는 옆 차선이 테레비맨치로 나온다 아이가"
  },
  {
   "a": 34.06,
   "b": 38.3,
   "at": 40.3,
   "text": "버튼은 와 이래 많노 그래도 화면은 억수로 크네"
  },
  {
   "a": 38.74,
   "b": 42.54,
   "at": 48.4,
   "text": "주차는 걱정 마라 카메라가 차를 위에서 비차 준다"
  },
  {
   "a": 42.97,
   "b": 46.1,
   "at": 53.6,
   "text": "사고 이력은 보배드림에서 보고 퍼뜩 온나"
  }
 ],

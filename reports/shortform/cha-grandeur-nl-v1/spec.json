  {
   "a": 24.77,
   "b": 26.65,
   "at": 25.05,
   "text": "공조는 터치 패널로 조작해요"
  },
  {
   "a": 27.11,
   "b": 29.57,
   "at": 27.39,
   "text": "주차할 땐 주변을 위에서 보여 주고요"
  },
  {
   "a": 29.99,
   "b": 32.47,
   "at": 30.27,
   "text": "가격은 2,330만 원이에요"
  },
  {
   "a": 32.86,
   "b": 34.66,
   "at": 33.14,
   "text": "보배드림 앱에서 확인해 보세요"

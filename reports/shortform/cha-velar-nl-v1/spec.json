   "at": 0.25,
   "text": "레인지로버 벨라 P400 다이내믹 HSE예요"
  },
  {
   "a": 4.08,
   "b": 7.26,
   "at": 4.36,
   "text": "작년 4월 등록에 1만 8천 킬로 탔어요"
  },
  {
   "a": 7.79,
   "b": 11.36,
   "at": 8.07,
   "text": "3.0 가솔린에 전기 모터가 힘을 보태는 P400"
  },
  {
   "a": 11.9,
   "b": 14.0,
   "at": 12.18,
   "text": "휠은 큼직한 다크 휠이고요"
  },
  {
   "a": 14.31,
   "b": 16.24,
   "at": 14.59,
   "text": "트렁크는 이만큼 깊습니다"
  },
  {
   "a": 16.81,
   "b": 19.01,
   "at": 17.09,
   "text": "뒷좌석 위로 파노라마 선루프가 있죠"
  },
  {
   "a": 19.67,
   "b": 22.42,
   "at": 19.95,
   "text": "실내는 큰 터치 화면 하나로 정리됐어요"
  },
  {
   "a": 22.75,
   "b": 24.31,
   "at": 23.03,
   "text": "계기판도 디지털이고요"
  },
  {
   "a": 24.81,
   "b": 27.3,
   "at": 25.09,
   "text": "주차할 땐 주변을 위에서 보여 줍니다"
  },
  {
   "a": 27.87,
   "b": 30.21,
   "at": 28.15,
   "text": "가격은 6,990만 원이에요"
  },
  {
   "a": 30.54,
   "b": 32.33,
   "at": 30.82,
   "text": "보배드림 앱에서 확인해 보세요"
  }
 ],

  "transcript": [
   {
    "start": 0.0,
    "end": 5.9,
    "text": "Als je zou moeten kiezen, ga jij voor de Mercedes-Benz GLA, GLC of de GLE?",
    "ko": "선택해야 한다면 메르세데스-벤츠 GLA, GLC, 아니면 GLE 중 어떤 걸 고르시겠어요?"
   },
   {
    "start": 5.9,
    "end": 10.7,
    "text": "Deze Mercedes-Benz GLA 250e is een plug-in hybride,",
    "ko": "이 메르세데스-벤츠 GLA 250e는 플러그인 하이브리드 모델이며,"
   },
   {
    "start": 10.7,
    "end": 12.8,
    "text": "komt uit 2022,",
    "ko": "2022년식이고,"
   },
   {
    "start": 12.8,
    "end": 14.8,
    "text": "66.800km,",
    "ko": "주행거리는 66,800km,"
   },
   {
    "start": 14.8,
    "end": 16.7,
    "text": "hij heeft 218 pk,",
    "ko": "218마력입니다."
   },
   {
    "start": 16.7,
    "end": 20.0,
    "text": "en hij kost €29.450.",
    "ko": "가격은 29,450유로입니다."
   },
   {
    "start": 20.0,
    "end": 23.9,
    "text": "Of ga jij voor de Mercedes-Benz GLC 43 AMG?",
    "ko": "아니면 메르세데스-벤츠 GLC 43 AMG를 고르시겠습니까?"
   },
   {
    "start": 23.9,

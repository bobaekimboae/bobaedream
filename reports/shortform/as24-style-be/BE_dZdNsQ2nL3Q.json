    "text": "hij komt uit 2017,",
    "ko": "2017년식,"
   },
   {
    "start": 27.5,
    "end": 29.5,
    "text": "hij heeft 367 pk,",
    "ko": "367마력,"
   },
   {
    "start": 29.5,
    "end": 32.5,
    "text": "en hij heeft 71.300km op de teller,",

  "transcript": [
   {
    "start": 0.0,
    "end": 2.2,
    "text": "Met welke auto ga jij naar het strand?",
    "ko": "어떤 차를 타고 해변에 가실 건가요?"
   },
   {
    "start": 2.2,
    "end": 4.5,
    "text": "Kies jij voor de Fiat Topolino?",
    "ko": "피아트 토폴리노를 고르시겠어요?"
   },
   {
    "start": 4.5,
    "end": 8.0,
    "text": "Hij gaat maximaal 45 km/u en je laadt hem op binnen 4 uurtjes.",
    "ko": "최고속도는 45km/h이고 4시간 만에 완충됩니다."
   },
   {
    "start": 8.0,
    "end": 10.0,
    "text": "Hij komt uit 2025,",
    "ko": "2025년식 모델이며,"
   },
   {
    "start": 10.0,
    "end": 12.1,
    "text": "en hij kost €13.900.",
    "ko": "가격은 13,900 유로입니다."
   },
   {
    "start": 12.1,
    "end": 14.5,
    "text": "En heb je na een dagje strand vieze voeten?",
    "ko": "해변에서 하루를 보낸 뒤 발이 더러워졌나요?"
   },
   {
    "start": 14.5,
    "end": 17.0,
    "text": "Daar heeft deze Topolino ook een oplossing voor.",
    "ko": "이 토폴리노에는 해결책이 있습니다."
   },
   {
    "start": 17.0,
    "end": 19.6,
    "text": "Een kleine mini douche om je voeten af te spoelen.",
    "ko": "발을 씻을 수 있는 작은 미니 샤워기죠."
   },
   {
    "start": 19.6,
    "end": 21.6,
    "text": "Of kies je toch voor de M3 Touring?",
    "ko": "아니면 M3 투어링을 선택하시겠어요?"
   },
   {
    "start": 21.6,
    "end": 24.5,
    "text": "Onder de kap ligt een 3L twin-turbo zes-in-lijn,",
    "ko": "보닛 아래에는 3.0L 직렬 6기통 트윈터보 엔진이 들어있고,"
   },
   {
    "start": 24.5,
    "end": 27.5,
    "text": "met 530 pk en 650 Nm koppel.",
    "ko": "530마력과 650Nm 토크를 냅니다."
   },
   {
    "start": 27.5,
    "end": 31.6,
    "text": "En tegelijkertijd heb je 500L aan kofferruimte,",
    "ko": "동시에 500L의 넉넉한 트렁크 공간과,"
   },
   {
    "start": 31.6,
    "end": 33.7,
    "text": "en ruimte voor het hele gezin.",
    "ko": "온 가족을 위한 여유 공간이 있습니다."
   },
   {
    "start": 33.7,
    "end": 37.0,
    "text": "Deze BMW M3 Touring komt uit 2026,",
    "ko": "이 BMW M3 투어링은 2026년식으로,"
   },
   {
    "start": 37.0,
    "end": 39.8,
    "text": "heeft 6.211 km gereden,",
    "ko": "주행거리는 6,211km입니다."
   },
   {
    "start": 39.8,
    "end": 42.1,
    "text": "en hij kost €102.900.",
    "ko": "가격은 102,900 유로입니다."
   },
   {
    "start": 42.1,
    "end": 44.8,
    "text": "Je vindt ze bij Auto-Point Casier,",
    "ko": "이 차들은 Auto-Point Casier와,"
   },
   {
    "start": 44.8,
    "end": 47.0,
    "text": "en op autoscout24.be.",
    "ko": "autoscout24.be에서 만나보실 수 있습니다."
   }
  ],

  "transcript": [
   {
    "start": 0.0,
    "end": 2.5,
    "text": "Gezinswagen nodig voor onder de 20.000 euro?",
    "ko": "2만 유로 미만의 패밀리카가 필요하신가요?"
   },
   {
    "start": 2.5,
    "end": 4.5,
    "text": "En met minder dan 100.000 km?",
    "ko": "주행거리도 10만 km 미만으로요?"
   },
   {
    "start": 4.5,
    "end": 6.5,
    "text": "Dit is de Ford Focus Clipper.",
    "ko": "이 차가 바로 포드 포커스 클리퍼입니다."
   },
   {
    "start": 6.5,
    "end": 8.7,
    "text": "En hij is uitgevoerd met bomvol opties, kom maar mee!",
    "ko": "옵션이 가득 차 있어요, 같이 보시죠!"
   },
   {
    "start": 8.7,
    "end": 11.0,
    "text": "Keyless entry, adaptive cruise control en lane assist,",
    "ko": "스마트키, 어댑티브 크루즈 컨트롤, 차선 유지 보조,"
   },
   {
    "start": 11.0,
    "end": 13.5,
    "text": "stoelverwarming en voorruitverwarming,",
    "ko": "시트 열선과 앞유리 열선,"
   },
   {
    "start": 13.5,
    "end": 15.0,
    "text": "verkeersbordherkenning,",
    "ko": "표지판 인식 기능,"
   },
   {
    "start": 15.0,
    "end": 18.9,
    "text": "verschillende rijstanden: Normaal, Eco en Sport,",
    "ko": "다양한 주행 모드: 노멀, 에코, 스포츠,"
   },
   {
    "start": 18.9,
    "end": 20.3,
    "text": "achteruitrijcamera,",
    "ko": "후방 카메라,"
   },
   {
    "start": 20.3,
    "end": 22.0,
    "text": "en genoeg ruimte voor het hele gezin.",
    "ko": "그리고 온 가족을 위한 넉넉한 공간."
   },
   {
    "start": 22.0,
    "end": 23.6,
    "text": "Bekerhouders en een skiluik,",
    "ko": "컵홀더와 스키 스루,"
   },
   {
    "start": 23.6,
    "end": 26.8,
    "text": "een elektrische kofferklep met zoveel ruimte, perfect voor een roadtrip.",
    "ko": "전동 트렁크와 엄청난 적재공간까지, 로드트립에 딱이죠."
   },
   {
    "start": 26.8,
    "end": 31.8,
    "text": "Hij komt uit 2022, heeft 99.500 km,",
    "ko": "2022년형에 주행거리는 99,500km이고,"
   },
   {
    "start": 31.8,
    "end": 33.7,
    "text": "en hij kost 15.900 euro.",
    "ko": "가격은 15,900유로입니다."
   },
   {
    "start": 33.7,
    "end": 38.4,
    "text": "Je vindt hem bij Autoswitch en op autoscout24.be.",
    "ko": "오토스위치와 autoscout24.be에서 만나보실 수 있습니다."
   }
  ],

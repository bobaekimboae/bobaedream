  "transcript": [
   {
    "start": 0.0,
    "end": 1.7,
    "text": "요새 마칸 와이래 이쁘노?",
    "ko": "요새 마칸 와이래 이쁘노?"
   },
   {
    "start": 1.7,
    "end": 3.4,
    "text": "야 내 마칸 사고싶다",
    "ko": "야 내 마칸 사고싶다"
   },
   {
    "start": 3.4,
    "end": 4.2,
    "text": "마칸?",
    "ko": "마칸?"
   },
   {
    "start": 4.2,
    "end": 4.8,
    "text": "어",
    "ko": "어"
   },
   {
    "start": 4.8,
    "end": 5.4,
    "text": "그래?",
    "ko": "그래?"
   },
   {
    "start": 5.4,
    "end": 6.2,
    "text": "내가 싸게 사는 방법 알려줄게",
    "ko": "내가 싸게 사는 방법 알려줄게"
   },
   {
    "start": 6.2,
    "end": 6.8,
    "text": "어떻게?",
    "ko": "어떻게?"
   },
   {
    "start": 7.0,
    "end": 8.1,
    "text": "이야 이 차 마음에 드네요",
    "ko": "이야 이 차 마음에 드네요"
   },
   {
    "start": 8.1,
    "end": 9.2,
    "text": "아 정말요? 이 차 얼마에요?",
    "ko": "아 정말요? 이 차 얼마에요?"
   },
   {
    "start": 9.2,
    "end": 10.7,
    "text": "요거는 5천만원입니다 고객님",
    "ko": "요거는 5천만원입니다 고객님"
   },
   {
    "start": 10.7,
    "end": 13.3,
    "text": "아 그럼 이거 레드 시트랑 레드 벨트",
    "ko": "아 그럼 이거 레드 시트랑 레드 벨트"
   },
   {
    "start": 13.3,
    "end": 15.6,
    "text": "그 다음 최고급 썬팅으로 바꾸고 다시 연락 주세요",
    "ko": "그 다음 최고급 썬팅으로 바꾸고 다시 연락 주세요"
   },
   {
    "start": 15.6,
    "end": 17.5,
    "text": "아 그러면 계약금을 먼저라도 좀...",
    "ko": "아 그러면 계약금을 먼저라도 좀..."
   },
   {
    "start": 17.5,
    "end": 18.9,
    "text": "에헤이 딜러님 이씨죠?",
    "ko": "에헤이 딜러님 이씨죠?"
   },
   {
    "start": 18.9,
    "end": 21.8,
    "text": "딱 알아보니까 할아버지의 팔촌에 손자뻘이더만",
    "ko": "딱 알아보니까 할아버지의 팔촌에 손자뻘이더만"
   },
   {
    "start": 21.8,
    "end": 24.6,
    "text": "집안 사람끼리 떼먹고 그러겠습니까 좀 잘해주세요",
    "ko": "집안 사람끼리 떼먹고 그러겠습니까 좀 잘해주세요"
   },
   {
    "start": 24.6,
    "end": 26.2,
    "text": "아 예 알겠습니다",
    "ko": "아 예 알겠습니다"
   },
   {
    "start": 27.2,
    "end": 31.5,
    "text": "아 고객님 레드 벨트랑 레드 시트 싹 다 해놨습니다. 와 차 진짜 이쁘네요 요거. 네 다 됐습니다.",
    "ko": "아 고객님 레드 벨트랑 레드 시트 싹 다 해놨습니다. 와 차 진짜 이쁘네요 요거. 네 다 됐습니다."
   },
   {
    "start": 31.5,
    "end": 35.1,
    "text": "아 저는 사고는 싶은데 부모님이 사지 말라고 하시네요",
    "ko": "아 저는 사고는 싶은데 부모님이 사지 말라고 하시네요"
   },
   {
    "start": 35.1,
    "end": 35.7,
    "text": "예?",
    "ko": "예?"
   },
   {
    "start": 35.7,
    "end": 39.0,
    "text": "하 부디 좋은 사람에게 차 보내주세요 부탁드리겠습니다",
    "ko": "하 부디 좋은 사람에게 차 보내주세요 부탁드리겠습니다"
   },
   {
    "start": 39.0,
    "end": 41.0,
    "text": "여보세요? 고객님 여보세요?",
    "ko": "여보세요? 고객님 여보세요?"
   },
   {
    "start": 44.5,
    "end": 47.0,
    "text": "어? 이 차 이쁘네. 이 차 얼마에요?",
    "ko": "어? 이 차 이쁘네. 이 차 얼마에요?"
   },
   {
    "start": 47.0,
    "end": 49.3,
    "text": "하 요거 차는 지금 한...",
    "ko": "하 요거 차는 지금 한..."
   },
   {
    "start": 49.3,
    "end": 51.5,
    "text": "아 이거 4,800에 파시면 제가 바로 살게요!",
    "ko": "아 이거 4,800에 파시면 제가 바로 살게요!"
   },
   {
    "start": 51.5,
    "end": 53.6,
    "text": "하 근데 이게 튜닝이 좀 되어 있어가지고",
    "ko": "하 근데 이게 튜닝이 좀 되어 있어가지고"
   },
   {
    "start": 53.6,
    "end": 55.8,
    "text": "근데 이거 지금 결정 안 하시면 저 안 살래요!",
    "ko": "근데 이거 지금 결정 안 하시면 저 안 살래요!"
   },
   {
    "start": 55.8,
    "end": 57.2,
    "text": "계약하러 갑시다...",
    "ko": "계약하러 갑시다..."
   },
   {
    "start": 57.2,
    "end": 57.8,
    "text": "네",
    "ko": "네"
   }
  ],

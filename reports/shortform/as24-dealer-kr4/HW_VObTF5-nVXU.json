  "transcript": [
   {
    "start": 0.0,
    "end": 1.1,
    "text": "차 좀 보러 왔는데예",
    "ko": "차 좀 보러 왔는데요"
   },
   {
    "start": 1.1,
    "end": 2.1,
    "text": "안녕하세요 고객님",
    "ko": "안녕하세요 고객님"
   },
   {
    "start": 2.1,
    "end": 4.1,
    "text": "어? 이 새끼는 학창시절에 나에게 삥을 존나 뜯어갔던 새끼네",
    "ko": "학창시절 나를 괴롭히던 일진"
   },
   {
    "start": 4.1,
    "end": 5.7,
    "text": "낯이 좀 익은데?",
    "ko": "낯이 좀 익은데?"
   },
   {
    "start": 5.7,
    "end": 6.8,
    "text": "어 저는 초면인데요?",
    "ko": "어 저는 초면인데요?"
   },
   {
    "start": 6.8,
    "end": 8.7,
    "text": "혹시 고등학교 어디 나왔는교?",
    "ko": "혹시 고등학교 어디 나왔어요?"
   },
   {
    "start": 8.7,
    "end": 10.0,
    "text": "저 한우고등학교 나왔습니다",
    "ko": "저 한우고등학교 나왔습니다"
   },
   {
    "start": 10.0,
    "end": 12.8,
    "text": "동네 사람이었네 한우고에 내 친구 존나 많은데",
    "ko": "동네 사람이었네 친구 많다"
   },
   {
    "start": 12.8,
    "end": 13.7,
    "text": "알아 개새끼야",
    "ko": "속마음"
   },
   {
    "start": 13.7,
    "end": 15.6,
    "text": "혹시 나이가 어떻게 됩니까?",
    "ko": "나이가 어떻게 되세요?"
   },
   {
    "start": 15.6,
    "end": 16.7,
    "text": "저 33살입니다",
    "ko": "저 33살입니다"
   },
   {
    "start": 16.7,
    "end": 19.4,
    "text": "셋이면 하나 아래네 말 놔도 되지 동생아?",
    "ko": "말 놔도 되지?"
   },
   {
    "start": 19.4,
    "end": 20.8,
    "text": "싫어 개새끼야",
    "ko": "속마음"
   },
   {
    "start": 20.8,
    "end": 22.8,
    "text": "네 형님 또 동생한테 차 한 대 팔아줘야지",
    "ko": "차 한 대 팔아줘야지"
   },
   {
    "start": 22.8,
    "end": 26.2,
    "text": "어 그럼 감사하죠 형님 (이때동안 너에게 삥 뜯겼던 거 다 회수할 거야)",
    "ko": "속마음으로 복수를 다짐"
   },
   {
    "start": 26.2,
    "end": 27.9,
    "text": "동생아 이 차 얼마고?",
    "ko": "이 차 얼마야?"
   },
   {
    "start": 27.9,
    "end": 33.0,
    "text": "아 요 차량 같은 경우는 3,300만 원입니다 형님",
    "ko": "2,900만 원짜리를 3,300만 원에 부름"
   },
   {
    "start": 33.0,
    "end": 34.8,
    "text": "3,300? 할인 좀 안 되나?",
    "ko": "할인 안 돼?"
   },
   {
    "start": 34.8,
    "end": 37.6,
    "text": "행님 다른 동네 행님들은 10원도 안 깎고 들고 가셨는데요",
    "ko": "자존심 긁는 딜러"
   },
   {
    "start": 37.6,
    "end": 42.4,
    "text": "오케이 콜! 할부 금리가 좀 어떻게 되노?",
    "ko": "할부 문의"
   },
   {
    "start": 42.4,
    "end": 46.1,
    "text": "다른 행님들은 다 일시불로 사가시던데요 행님",
    "ko": "일시불 유도"
   },
   {
    "start": 46.1,
    "end": 48.9,
    "text": "그러면 이 차는 한 이틀 정도 생각을 해보고",
    "ko": "생각해본다고 하자"
   },
   {
    "start": 48.9,
    "end": 52.8,
    "text": "다른 행님들은 당일 바로 출고하시고 들고 가시던데요",
    "ko": "당일 출고 유도"
   },
   {
    "start": 52.8,
    "end": 55.4,
    "text": "오케이 콜! 동생아 계약하러 가자!",
    "ko": "자존심 때문에 바로 계약"
   },
   {
    "start": 55.4,
    "end": 59.5,
    "text": "아싸 15년 전에 삥 뜯겼던 거 플러스 이자까지 고맙다 호구 새끼야! 가시죠",
    "ko": "바가지 씌우기 성공"
   }

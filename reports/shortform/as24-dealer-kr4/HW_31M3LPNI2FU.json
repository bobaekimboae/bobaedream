  "transcript": [
   {
    "start": 0.5,
    "end": 2.4,
    "text": "어 이거 문열 때 소리가 좀 빈 깡통 같은데",
    "ko": "어 이거 문열 때 소리가 좀 빈 깡통 같은데"
   },
   {
    "start": 2.8,
    "end": 4.5,
    "text": "예? 이거 문 무거운 편일 텐데",
    "ko": "예? 이거 문 무거운 편일 텐데"
   },
   {
    "start": 4.7,
    "end": 6.1,
    "text": "일단 이거 한 50 깎고",
    "ko": "일단 이거 한 50 깎고"
   },
   {
    "start": 6.2,
    "end": 6.7,
    "text": "예?",
    "ko": "예?"
   },
   {
    "start": 6.8,
    "end": 8.1,
    "text": "함 가서 함 봐야지",
    "ko": "함 가서 함 봐야지"
   },
   {
    "start": 9.8,
    "end": 12.0,
    "text": "어 이거 클락션 소리가 좀 많이 이상한데 이거",
    "ko": "어 이거 클락션 소리가 좀 많이 이상한데 이거"
   },
   {
    "start": 12.1,
    "end": 13.4,
    "text": "어 저는 괜찮은 거 같은데",
    "ko": "어 저는 괜찮은 거 같은데"
   },
   {
    "start": 13.5,
    "end": 16.2,
    "text": "에이 이건 소리가 좀 별론데 이거는 한 50만 원 깎아야겠네요 이거는",
    "ko": "에이 이건 소리가 좀 별론데 이거는 한 50만 원 깎아야겠네요 이거는"
   },
   {
    "start": 16.3,
    "end": 17.5,
    "text": "아 이걸로요?",
    "ko": "아 이걸로요?"
   },
   {
    "start": 17.6,
    "end": 20.8,
    "text": "아 요거는 그렇고 요거는 색깔이 또 검정색이네",
    "ko": "아 요거는 그렇고 요거는 색깔이 또 검정색이네"
   },
   {
    "start": 20.9,
    "end": 24.5,
    "text": "요런 거는 때도 많이 타고 별로 인기도 없고 이건 100만 원 정도 깎아야 되겠고 이거는",
    "ko": "요런 거는 때도 많이 타고 별로 인기도 없고 이건 100만 원 정도 깎아야 되겠고 이거는"
   },
   {
    "start": 24.6,
    "end": 26.0,
    "text": "검정색 인기 많은데요?",
    "ko": "검정색 인기 많은데요?"
   },
   {
    "start": 26.1,
    "end": 27.5,
    "text": "아이 안 됐고",
    "ko": "아이 안 됐고"
   },
   {
    "start": 27.6,
    "end": 29.5,
    "text": "에 번호가 4444네요?",
    "ko": "에 번호가 4444네요?"
   },
   {
    "start": 29.6,
    "end": 31.8,
    "text": "아 요거는 100만 원 무조건 깎아야 됩니다 요거는",
    "ko": "아 요거는 100만 원 무조건 깎아야 됩니다 요거는"
   },
   {
    "start": 31.9,
    "end": 33.2,
    "text": "에이 이거 골든 넘버인데요?",
    "ko": "에이 이거 골든 넘버인데요?"
   },
   {
    "start": 33.3,
    "end": 34.5,
    "text": "아이 100만 깎아야",
    "ko": "아이 100만 깎아야"
   },
   {
    "start": 34.6,
    "end": 38.4,
    "text": "그러면 요 차는 전체적으로 문제가 좀 많은 거 같은데 처음에 얼마라 했죠 요거?",
    "ko": "그러면 요 차는 전체적으로 문제가 좀 많은 거 같은데 처음에 얼마라 했죠 요거?"
   },
   {
    "start": 38.5,
    "end": 39.7,
    "text": "2,200만 원이요",
    "ko": "2,200만 원이요"
   },
   {
    "start": 39.8,
    "end": 41.5,
    "text": "에이 그러면 한 1,800만 원 딱 하면 되겠네",
    "ko": "에이 그러면 한 1,800만 원 딱 하면 되겠네"
   },
   {
    "start": 41.6,
    "end": 43.6,
    "text": "아 좋습니다 거래하러 가시죠",
    "ko": "아 좋습니다 거래하러 가시죠"
   },
   {
    "start": 43.7,
    "end": 44.7,
    "text": "가입시다 가입시다",
    "ko": "가입시다 가입시다"
   },
   {
    "start": 45.0,
    "end": 46.9,
    "text": "야 중혁아 야이씨",
    "ko": "야 중혁아 야이씨"
   },
   {
    "start": 47.0,
    "end": 49.3,
    "text": "니 차 이거 2,200에 사기로 했다며",
    "ko": "니 차 이거 2,200에 사기로 했다며"
   },
   {
    "start": 49.4,
    "end": 50.8,
    "text": "요거 내가 1,800만 원에 거래하기로 했디",
    "ko": "요거 내가 1,800만 원에 거래하기로 했디"
   },
   {
    "start": 50.9,
    "end": 52.0,
    "text": "어?",
    "ko": "어?"
   },
   {
    "start": 52.1,
    "end": 53.4,
    "text": "진짜가 이거 니가 차 사는 게 아니고",
    "ko": "진짜가 이거 니가 차 사는 게 아니고"
   },
   {
    "start": 53.5,
    "end": 54.7,
    "text": "파는 거가?",
    "ko": "파는 거가?"
   },
   {
    "start": 54.8,
    "end": 55.7,
    "text": "니 차 사러 온 딜러가?",
    "ko": "니 차 사러 온 딜러가?"
   },
   {
    "start": 55.8,
    "end": 57.5,
    "text": "아 진짜가 아 씨",
    "ko": "아 진짜가 아 씨"
   }

  "transcript": [
   {
    "start": 0.0,
    "end": 2.7,
    "text": "위치 진짜 헬이네 아... 이러니까 배달이 안 잡혔구나.",
    "ko": "위치 진짜 헬이네 아... 이러니까 배달이 안 잡혔구나."
   },
   {
    "start": 3.0,
    "end": 6.4,
    "text": "와 멀다... 아 안녕하세요? 치킨 시키신 분 맞으시죠?",
    "ko": "와 멀다... 아 안녕하세요? 치킨 시키신 분 맞으시죠?"
   },
   {
    "start": 6.4,
    "end": 9.2,
    "text": "아 네 왜 이렇게 늦게 왔어요? 아 치킨 다 식었겠네 아...",
    "ko": "아 네 왜 이렇게 늦게 왔어요? 아 치킨 다 식었겠네 아..."
   },
   {
    "start": 9.2,
    "end": 11.4,
    "text": "예? 어? 배달 예상 시간보다 20분이나 빨리 왔는데...",
    "ko": "예? 어? 배달 예상 시간보다 20분이나 빨리 왔는데..."
   },
   {
    "start": 11.4,
    "end": 14.7,
    "text": "아 됐고 아 씨... 젓가락은 왜 두 개예요?",
    "ko": "아 됐고 아 씨... 젓가락은 왜 두 개예요?"
   },
   {
    "start": 14.7,
    "end": 16.9,
    "text": "어? 배달 요청 사항에 없어 가지고 제가 혹시나 해서 더 챙겨온...",
    "ko": "어? 배달 요청 사항에 없어 가지고 제가 혹시나 해서 더 챙겨온..."
   },
   {
    "start": 16.9,
    "end": 23.6,
    "text": "하 센스 없게 아 씨 4개는 줘야지! 아 이러니까 배달이나 하지. 하이바는 왜 또 안 썼노? 돈이 없나? 거지이가 이거 아...",
    "ko": "하 센스 없게 아 씨 4개는 줘야지! 아 이러니까 배달이나 하지. 하이바는 왜 또 안 썼노? 돈이 없나? 거지이가 이거 아..."
   },
   {
    "start": 23.6,
    "end": 25.6,
    "text": "예? 아니 뭐 제가 잘못한 거라도 있습니까?",
    "ko": "예? 아니 뭐 제가 잘못한 거라도 있습니까?"
   },
   {
    "start": 25.6,
    "end": 28.5,
    "text": "아씨 됐고! 젓가락이나 더 들고 오이소!",
    "ko": "아씨 됐고! 젓가락이나 더 들고 오이소!"
   },
   {
    "start": 28.5,
    "end": 30.7,
    "text": "아 예, 사다 드릴게요 더.",
    "ko": "아 예, 사다 드릴게요 더."
   },
   {
    "start": 30.7,
    "end": 33.7,
    "text": "아씨 별점 테러해뿌라, 존나 짜증 나게.",
    "ko": "아씨 별점 테러해뿌라, 존나 짜증 나게."
   },
   {
    "start": 34.5,
    "end": 37.8,
    "text": "아 술이 없노 아씨. 또 술 사러 가야겠네.",
    "ko": "아 술이 없노 아씨. 또 술 사러 가야겠네."
   },
   {
    "start": 39.0,
    "end": 44.0,
    "text": "어?! 이 동네에 이래 비싼 차가 있나, 와... 와 포르쉐 아이가 이거!!",
    "ko": "어?! 이 동네에 이래 비싼 차가 있나, 와... 와 포르쉐 아이가 이거!!"
   },
   {
    "start": 44.1,
    "end": 49.6,
    "text": "와 차 좋네 이거. 와 난 월세도 밀렸는데, 이런 건 얼마짜리고... 누가 타는 기고 이런 건...",
    "ko": "와 차 좋네 이거. 와 난 월세도 밀렸는데, 이런 건 얼마짜리고... 누가 타는 기고 이런 건..."
   },
   {
    "start": 51.0,
    "end": 53.0,
    "text": "어! 고객님! 젓가락 받아 가셔야죠.",
    "ko": "어! 고객님! 젓가락 받아 가셔야죠."
   },
   {
    "start": 53.1,
    "end": 55.0,
    "text": "누가 거지이고?",
    "ko": "누가 거지이고?"
   },
   {
    "start": 55.1,
    "end": 56.5,
    "text": "아 예, 주이소.",
    "ko": "아 예, 주이소."
   },
   {
    "start": 56.6,
    "end": 57.7,
    "text": "개쪽팔리네 진짜...",
    "ko": "개쪽팔리네 진짜..."
   }

  "captions": [
    {
      "start": 0.5489999999999999,
      "end": 4.602,
      "text": "큰 SUV, 크기만 보고 고르면\n놓치는 게 있죠.",
      "sourceCaptionRange": [
        0,
        2
      ]
    },
    {
      "start": 4.602,
      "end": 9.84,
      "text": "매일 쓰는 부분이 얼마나 편한지,\n이 BMW X5에서 같이 보시죠.",
      "sourceCaptionRange": [
        3,
        6
      ]
    },
    {
      "start": 9.84,
      "end": 13.894,
      "text": "앞에서는 큼직한 키드니 그릴과\n헤드램프가 눈에 들어옵니다.",
      "sourceCaptionRange": [
        7,
        9
      ]
    },
    {
      "start": 13.894,
      "end": 18.246,
      "text": "실내로 들어가면 브라운 톤 도어와\n운전석이 분위기를 바꾸네요.",
      "sourceCaptionRange": [
        10,
        12
      ]
    },
    {
      "start": 18.246,
      "end": 21.681,
      "text": "센터를 보세요.\n화면 아래에 공조 버튼이 따로 있고,",
      "sourceCaptionRange": [
        13,
        15
      ]
    },
    {
      "start": 21.681,
      "end": 24.412,
      "text": "기어 셀렉터 주변에도\n조작부가 모여 있습니다.",
      "sourceCaptionRange": [
        16,
        17
      ]
    },
    {
      "start": 24.412,
      "end": 29.386,
      "text": "온도 표시도 다르죠? 운전석은 17도,\n동승석은 17.5도.",
      "sourceCaptionRange": [
        18,
        20
      ]
    },
    {
      "start": 29.386,
      "end": 32.032,
      "text": "양쪽 온도를 따로 맞춘 모습입니다.",
      "sourceCaptionRange": [
        21,
        21
      ]
    },
    {
      "start": 32.032,
      "end": 35.018,
      "text": "도어에는\n시트 메모리 버튼도 보입니다.",
      "sourceCaptionRange": [
        22,
        23
      ]
    },
    {
      "start": 35.018,
      "end": 40.374,
      "text": "이런 기능은 사진만 보지 말고, 실제로 눌러\n위치가 잘 돌아오는지도 확인해 보세요.",
      "sourceCaptionRange": [
        24,
        27
      ]
    },
    {
      "start": 40.374,
      "end": 43.105,
      "text": "트렁크는\n위아래로 나뉘어 열리는 구조예요.",
      "sourceCaptionRange": [
        28,
        29
      ]
    },
    {
      "start": 43.105,
      "end": 46.647,
      "text": "아래쪽을 내리면\n짐을 싣는 면이 이렇게 펼쳐집니다.",
      "sourceCaptionRange": [
        30,
        32
      ]
    },
    {
      "start": 46.647,
      "end": 51.235,
      "text": "결국 중요한 건 멋진 첫인상과\n내가 쓸 때의 편리함이겠죠.",
      "sourceCaptionRange": [
        33,
        35
      ]
    },
    {
      "start": 51.235,
      "end": 56.056,
      "text": "마음에 드셨다면 매물 정보와\n실제 작동 상태까지 함께 확인해 보세요.",
      "sourceCaptionRange": [
        36,
        38
      ]
    },
    {
      "start": 56.056,
      "end": 59.2,
      "text": "보배드림이었습니다.",
      "sourceCaptionRange": [
        39,
        39
      ]
    }
  ]
}

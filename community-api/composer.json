{
    "name": "bobaedream/community-api",
    "description": "보배드림 커뮤니티 리뷰 · 연비 게시판 API (Laravel 12 · PHP 8.4)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" }
    },
    "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}

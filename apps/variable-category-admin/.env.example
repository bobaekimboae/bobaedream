APP_NAME="Bobaedream Category Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Seoul

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=category_admin
DB_USERNAME=category_admin
DB_PASSWORD=change-me-local-only

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_HOST=redis
REDIS_PORT=6379

# 기존 매물 DB는 읽기 전용 계정만 사용한다.
LEGACY_LISTING_CONNECTION=legacy
LEGACY_DB_HOST=
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_LISTING_TABLE=listings
LEGACY_LISTING_ID_COLUMN=id
LEGACY_CATEGORY_COLUMN=category_code
LEGACY_SELLER_TYPE_COLUMN=seller_type

RELEASE_CACHE_TTL=300
RESOLVER_SHADOW_MODE=true

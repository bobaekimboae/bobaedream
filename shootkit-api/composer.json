{
    "name": "bobaedream/shootkit-api",
    "description": "보배드림 촬영 키트 임시 업로드 서버 (Laravel 12)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

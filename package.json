{
  "name": "bobaedream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "admin:start": "node admin-server/start.mjs",
    "admin:seed": "node admin-server/seed.mjs",
    "test:admin": "node --test tests/category-admin-api.test.mjs",
    "verify:admin": "npm run test:admin",
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "verify:qf": "npm run check:runtime && node scripts/build-info.mjs && tsc && vite build",
    "measure:qf": "node scripts/qf-measure.mjs",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "storybook:build": "storybook build -o dist/client/storybook",
    "chromatic": "chromatic --storybook-build-dir dist/client/storybook",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "node scripts/build-info.mjs && tsc && vite build && node scripts/prepare-sites-build.mjs && node apps/variable-category-admin/scripts/sync-pages-demo.mjs",
    "verify": "npm run check:runtime && npm run test:admin && npm run build && npm run test:sites",
    "diff:bbm": "node scripts/bbm-diff.mjs",
    "diff:bbm:flow": "node scripts/bbm-diff-flow.mjs",
    "regress:modes": "node scripts/regress-modes.mjs",
    "check:hybrid": "node scripts/pc-hybrid-check.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "simple-icons": "16.28.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "chromatic": "^18.7.2",
    "storybook": "^10.5.10",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}

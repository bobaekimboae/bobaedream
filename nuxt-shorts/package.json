{
  "name": "bobaedream-nuxt-shorts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "nuxt dev --port 5197",
    "build": "nuxt generate",
    "preview": "node scripts/serve.mjs",
    "typecheck": "nuxt typecheck",
    "snapshot": "node scripts/snapshot.mjs",
    "export": "nuxt generate && node scripts/copy-to-site.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "vue": "3.5.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "10.33.0"
  },
  "pnpm": {
    "overrides": {
      "vue": "3.5.33",
      "@vue/compiler-core": "3.5.33",
      "@vue/compiler-dom": "3.5.33",
      "@vue/compiler-sfc": "3.5.33",
      "@vue/compiler-ssr": "3.5.33",
      "@vue/shared": "3.5.33",
      "@vue/server-renderer": "3.5.33"
    }
  }
}
